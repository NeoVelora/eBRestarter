	<LangVersion>preview</LangVersion>
    <RootNamespace>eBRestarter.Desktop.WinUI3</RootNamespace>
    <AssemblyName>eBRestarter</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
	<ApplicationIcon>Assets\eB Restarter.ico</ApplicationIcon>
    <SupportedUICultures>de-DE;en-US</SupportedUICultures>
    <DefaultLanguage>en-US</DefaultLanguage>
	<WindowsPackageType>None</WindowsPackageType>
	<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
	<RuntimeIdentifier>win-x64</RuntimeIdentifier>
	<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
	<!--
	  Guide Kap. 25.2 (ReadyToRun): Kompiliert Startup-Pfade zur Build-Zeit vor, damit der JIT
	  sie beim Start nicht mehr übersetzen muss. Der RID ist oben bereits fixiert (win-x64),
	  die R2R-Voraussetzung ist also erfüllt. Die App startet mit dem System (Autostart),
	  Kaltstart ist damit nutzerwahrnehmbar.
	  ⚠️ Trade-off laut Guide: größere Deployment-Artefakte. Wirkt nur bei `dotnet publish`,
	  nicht bei `dotnet build`. Vor der endgültigen Übernahme gemäß Kap. 20 messen — bei einer
	  selfcontained WinUI-3-App ist der Netto-Effekt nicht vorhersagbar.
	  Native AOT (Kap. 25.3) ist ausgeschlossen: COM-Interop, WMI und Assembly-Scanning
	  (AddValidatorsFromAssemblyContaining) sind laut Kap.-25.3-Tabelle AOT-Blocker.
	-->
	<PublishReadyToRun>true</PublishReadyToRun>
	<!--
	  🔒 Security-Guideline Kap. 7.3 (Reproduzierbarkeit): packages.lock.json fixiert die exakten
	  transitiven Versionen, damit derselbe Commit nicht zu unterschiedlichen Zeitpunkten
	  unterschiedliche (und potenziell kompromittierte) Paketversionen zieht.
	-->
	<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
