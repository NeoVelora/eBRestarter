<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="eBRestarter.Desktop.WinUI3.Views.Pages.P_RestarterProperties"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:eBRestarter.Desktop.WinUI3.Views.Pages"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:userControls="using:eBRestarter.Desktop.WinUI3.Views.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Grid x:Name="MainGrid"
          CornerRadius="8,0,0,0">

        <!-- 2 Zeilen: oben Titel, unten Inhalt -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- OBERER BALKEN -->
        <StackPanel Grid.Row="0"
            Background="{ThemeResource MenuBackgroundColor_3}"
            Orientation="Horizontal"
            Height="35"
                   
            VerticalAlignment="Center"
            Spacing="10"
            Padding="10,0,0,0">

            <FontIcon Glyph="&#xECA5;"
              FontFamily="Segoe MDL2 Assets"
              Foreground="{ThemeResource FontColor_1}"
              FontSize="28"
              VerticalAlignment="Center"/>

            <TextBlock x:Name="tbl_MainWindowTitle"
               Foreground="{ThemeResource FontColor_1}"
                       Margin="0,-3,0,0"
               Text="Einstellungen"
               VerticalAlignment="Center"
               FontSize="18"
               FontWeight="Bold"/>
            
        </StackPanel>

        <!-- INHALT -->


        <Grid Grid.Row="1">
            <!-- links: flexibel, rechts: so breit wie nötig und immer am rechten Rand -->
            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />

            </Grid.ColumnDefinitions>

            <!-- LINKE SPALTE: GridView mit Wrap -->
            <GridView Grid.Column="0"
                          IsItemClickEnabled="False"
                          SelectionMode="None"
                          HorizontalAlignment="Left">

                <GridView.ItemsPanel>

                    <ItemsPanelTemplate>

                        <controls:ItemsWrapGrid Orientation="Horizontal"
                                                    />
                    </ItemsPanelTemplate>

                </GridView.ItemsPanel>

                <GridView.ItemContainerStyle>

                    <Style TargetType="GridViewItem">

                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="20,20,10,0" />

                    </Style>

                </GridView.ItemContainerStyle>

                <userControls:UC_eVisitorUsername Width="320"
                                                      Height="220"/>

                <userControls:UC_RestartAndRuntimeOptions Width="320"
                                                              Height="220"/>

                <userControls:UC_AutomatedTasks Width="320"
                                                    Height="220"/>

                <userControls:UC_AdditionalOptions Width="320"
                                                       Height="220"/>
            </GridView>

            <!--RECHTE SPALTE: InstalledBrowsers rechtsbündig-->
            <ScrollViewer Grid.Column="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalAlignment="Right">

                <StackPanel>

                    <userControls:UC_InstalledBrowsers Width="265"
                                                           Height="Auto"
                                                           Margin="10,20,10,0" />
                </StackPanel>

            </ScrollViewer>

        </Grid>

    </Grid>
    
</Page>
