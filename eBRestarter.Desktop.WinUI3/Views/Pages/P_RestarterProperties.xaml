<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="eBRestarter.Desktop.WinUI3.Views.Pages.P_RestarterProperties"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:eBRestarter.Desktop.WinUI3.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:userControls="using:eBRestarter.Desktop.WinUI3.Views.UserControls"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Grid
        x:Name="MainGrid"
        Background="{ThemeResource MenuBackgroundColor_2}"
        CornerRadius="8,0,0,0">

        <!--  2 Zeilen: oben Titel, unten Inhalt  -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  OBERER BALKEN  -->
        <StackPanel
            Grid.Row="0"
            Height="35"
            Margin="5,5,5,0"
            Padding="10,0,0,0"
            VerticalAlignment="Center"
            Background="{ThemeResource MenuBackgroundColor}"
            CornerRadius="8"
            Orientation="Horizontal"
            Spacing="10">

            <FontIcon
                VerticalAlignment="Center"
                FontFamily="Segoe MDL2 Assets"
                FontSize="28"
                Foreground="{ThemeResource FontColor_1}"
                Glyph="&#xECA5;" />

            <TextBlock
                x:Name="tbl_MainWindowTitle"
                x:Uid="Properties"
                Margin="0,-3,0,0"
                VerticalAlignment="Center"
                FontSize="18"
                FontWeight="Bold"
                Foreground="{ThemeResource FontColor_1}"
                Text="Einstellungen" />

        </StackPanel>

        <!--  INHALT  -->


        <Grid Grid.Row="1">
            <!--  links: flexibel, rechts: so breit wie nötig und immer am rechten Rand  -->
            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />

            </Grid.ColumnDefinitions>

            <!--  LINKE SPALTE: GridView mit Wrap  -->
            <GridView
                Grid.Column="0"
                HorizontalAlignment="Left"
                IsItemClickEnabled="False"
                SelectionMode="None">

                <GridView.ItemsPanel>

                    <ItemsPanelTemplate>

                        <controls:ItemsWrapGrid Background="{ThemeResource MenuBackgroundColor_2}" Orientation="Horizontal" />
                    </ItemsPanelTemplate>

                </GridView.ItemsPanel>

                <GridView.ItemContainerStyle>

                    <Style TargetType="GridViewItem">

                        <Setter Property="Padding" Value="5,0,0,0" />
                        <Setter Property="Margin" Value="0,20,0,0" />

                    </Style>

                </GridView.ItemContainerStyle>

                <userControls:UC_eVisitorUsername Width="320" Height="220" />

                <userControls:UC_RestartAndRuntimeOptions Width="320" Height="220" />

                <userControls:UC_AutomatedTasks Width="320" Height="220" />

                <userControls:UC_AdditionalOptions Width="320" Height="220" />
            </GridView>

            <!--  RECHTE SPALTE: InstalledBrowsers rechtsbündig  -->
            <ScrollViewer
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource MenuBackgroundColor_2}"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">

                <userControls:UC_InstalledBrowsers
                    Width="270"
                    Height="Auto"
                    Margin="0,20,10,10" />

            </ScrollViewer>

        </Grid>

    </Grid>

</Page>
