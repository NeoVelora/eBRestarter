<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="eBRestarter.Desktop.WinUI3.Views.Dialogs.ActivateApiDialog"
   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    mc:Ignorable="d"
    Title="API Zugang aktivieren"
    CloseButtonText="Schließen"
    Style="{StaticResource DefaultContentDialogStyle}"
    RequestedTheme="Dark">

    <ContentDialog.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
        <converters:BoolNegationConverter x:Key="BoolNegationConverter"/>
    </ContentDialog.Resources>

    <Grid MinWidth="400" RowSpacing="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="15">
            <Image Source="ms-appx:///Assets/Images/Icons/Intersection/fa_keyaccess.png" 
                   Width="40" Height="40"/>
            <TextBlock Text="Eingabe der API Zugangsdaten" 
                       VerticalAlignment="Center" Style="{ThemeResource SubtitleTextBlockStyle}"/>
        </StackPanel>

        <TextBox Grid.Row="1" 
                 Header="Nutzername" 
                 Text="{x:Bind ActivateApiViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 PlaceholderText="eBesucher Nutzername"
                 IsEnabled="{x:Bind ActivateApiViewModel.IsBusy, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}"/>

        <PasswordBox Grid.Row="2" 
                     Header="API Schlüssel" 
                     Password="{x:Bind ActivateApiViewModel.ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="Ihr API Key"
                     IsEnabled="{x:Bind ActivateApiViewModel.IsBusy, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}"/>

        <Button Grid.Row="3" 
                Content="Aktivieren"
                Command="{x:Bind ActivateApiViewModel.SubmitCommand}"
                HorizontalAlignment="Stretch"
                Style="{ThemeResource AccentButtonStyle}"/>

        <StackPanel Grid.Row="4" Spacing="10">
            <ProgressBar IsIndeterminate="True" 
                         Visibility="{x:Bind ActivateApiViewModel.IsBusy, Converter={StaticResource BoolToVisConverter}, Mode=OneWay}"/>

            <TextBlock Text="{x:Bind ActivateApiViewModel.StatusMessage, Mode=OneWay}"
                       Foreground="{x:Bind ActivateApiViewModel.StatusColor, Mode=OneWay}"
                       HorizontalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </StackPanel>

    </Grid>
</ContentDialog>
