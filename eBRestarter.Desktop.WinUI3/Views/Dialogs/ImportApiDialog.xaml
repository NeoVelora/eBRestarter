<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="eBRestarter.Desktop.WinUI3.Views.Dialogs.ImportApiDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="API Zugang importieren"
    CloseButtonText="Schließen"
    RequestedTheme="Dark"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <converters:BoolNegationConverter x:Key="BoolNegationConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
    </ContentDialog.Resources>

    <Grid MinWidth="500" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="15">
            <Image
                Width="40"
                Height="40"
                Source="{ThemeResource AddFileIcon_2}" />
            <TextBlock
                VerticalAlignment="Center"
                Style="{ThemeResource SubtitleTextBlockStyle}"
                Text="API Zugang aus Datei importieren" />
        </StackPanel>

        <Button
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            Click="BtnBrowse_Click"
            Content="Durchsuchen..."
            IsEnabled="{x:Bind ViewModelImportApi.IsBusy, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}" />

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Margin="0,0,0,10"
                HorizontalAlignment="Center"
                Opacity="0.6"
                Text="oder" />

            <Border
                Grid.Row="1"
                Padding="20"
                AllowDrop="True"
                Background="Transparent"
                BorderBrush="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                BorderThickness="2"
                CornerRadius="4"
                DragOver="DropZone_DragOver"
                Drop="DropZone_Drop">
                <StackPanel HorizontalAlignment="Center" Spacing="10">
                    <Image
                        Width="48"
                        Height="48"
                        Source="{x:Bind ViewModelImportApi.FileStatusIcon, Mode=OneWay}" />

                    <TextBlock
                        HorizontalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModelImportApi.ImportedFileName, Mode=OneWay, TargetNullValue='Datei hier ablegen'}" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBox
            Grid.Row="3"
            Header="Dateipfad"
            IsEnabled="False"
            IsReadOnly="True"
            Text="{x:Bind ViewModelImportApi.ImportedFilePath, Mode=OneWay}" />

        <Button
            Grid.Row="4"
            HorizontalAlignment="Stretch"
            Command="{x:Bind ViewModelImportApi.ImportCommand}"
            Content="Importieren &amp; Aktivieren"
            Style="{ThemeResource AccentButtonStyle}" />

        <StackPanel Grid.Row="5" Spacing="10">
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModelImportApi.IsBusy, Converter={StaticResource BoolToVisConverter}, Mode=OneWay}" />

            <TextBlock
                HorizontalAlignment="Center"
                FontWeight="SemiBold"
                Foreground="{x:Bind ViewModelImportApi.StatusColor, Mode=OneWay}"
                Text="{x:Bind ViewModelImportApi.StatusMessage, Mode=OneWay}"
                TextWrapping="Wrap" />
        </StackPanel>

    </Grid>
</ContentDialog>
