<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="eBRestarter.Desktop.WinUI3.Views.Dialogs.AboutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:eBRestarter.Desktop.WinUI3.Views.Dialogs"
    xmlns:models="using:eBRestarter.Core.Domain.Models.Records"
    xmlns:VM="using:eBRestarter.Desktop.WinUI3.ViewModels"
    d:DataContext="{d:DesignInstance Type=VM:ViewModelAbout}"
    mc:Ignorable="d"
    x:Uid="AboutDialog"
    DefaultButton="Close">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10">

            <TextBlock x:Uid="AboutDialog_VersionHeader"
                       HorizontalAlignment="Center" FontWeight="Bold" FontSize="16"/>

            <TextBlock Text="{Binding AppVersion}" 
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock x:Uid="AboutDialog_CreditsHeader"
                       HorizontalAlignment="Center" FontWeight="Bold" FontSize="18"/>

            <TextBlock x:Uid="AboutDialog_DevRole" 
                       HorizontalAlignment="Center" FontWeight="Bold"/>

            <TextBlock x:Uid="AboutDialog_DevName" 
                       HorizontalAlignment="Center"/>

            <TextBlock x:Uid="AboutDialog_AssetsHeader"
                       HorizontalAlignment="Center" 
                       FontWeight="Bold" 
                       FontSize="16" 
                       Margin="0,20,0,10"/>

            <ItemsControl ItemsSource="{Binding IconCredits}">

                <ItemsControl.ItemTemplate>

                    <DataTemplate x:DataType="models:IconCredit">

                        <Grid Margin="0,5">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <Image Source="{x:Bind IconImageSource}" 
                                   Width="32" Height="32" 
                                   Margin="0,0,10,0" 
                                   VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                <TextBlock Text="{x:Bind IconCreator}" 
                                           FontWeight="SemiBold" 
                                           TextWrapping="Wrap"/>

                                <HyperlinkButton Content="{x:Bind IconHyperLink}" 
                                                 NavigateUri="{x:Bind IconHyperLinkContent}"
                                                 FontSize="12"
                                                 Padding="0"
                                                 HorizontalAlignment="Left"
                                                 Margin="0"/>
                            </StackPanel>

                        </Grid>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </StackPanel>

    </ScrollViewer>

</ContentDialog>