<ContentDialog
    x:Class="eBRestarter.Desktop.WinUI3.Views.Dialogs.InstallAddOnDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:eBRestarter.Desktop.WinUI3.ViewModels"
    mc:Ignorable="d"
    Title="Ebesucher Add-on verwalten"
    CloseButtonText="Schließen"
    DefaultButton="Close"
    Style="{StaticResource DefaultContentDialogStyle}"
    RequestedTheme="Dark">

    <Grid RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Wähle einen Browser aus, um das Add-on zu installieren oder zu verwalten."
                   Style="{ThemeResource BodyTextBlockStyle}"
                   Opacity="0.8"
                   TextWrapping="Wrap"/>

        <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModelInstallAddOn.Browsers, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ViewModelBrowserAddonStatus">

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,12"
                            Margin="0,0,0,12">

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Image Source="{x:Bind IconPath, Mode=OneWay}" 
                                   Width="40" Height="40" 
                                   VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind BrowserName, Mode=OneWay}" 
                                               Style="{ThemeResource SubtitleTextBlockStyle}"/>

                                    <Border Background="{x:Bind InstallStatusColor, Mode=OneWay}"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind InstallStatusText, Mode=OneWay}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="White" 
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{x:Bind AddonStatusIcon, Mode=OneWay}"
                                               Foreground="{x:Bind AddonStatusColor, Mode=OneWay}"
                                               FontFamily="Segoe UI Symbol"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Text="{x:Bind AddonStatusText, Mode=OneWay}"
                                               Style="{ThemeResource BodyTextBlockStyle}"
                                               Opacity="0.7"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Content="{x:Bind ButtonText, Mode=OneWay}"
                                    Command="{x:Bind OpenStoreCommand}"
                                    IsEnabled="{x:Bind IsButtonEnabled, Mode=OneWay}"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</ContentDialog>