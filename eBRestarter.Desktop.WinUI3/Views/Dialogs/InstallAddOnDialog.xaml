<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="eBRestarter.Desktop.WinUI3.Views.Dialogs.InstallAddOnDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:eBRestarter.Desktop.WinUI3.ViewModels"
    mc:Ignorable="d"
    Title="Ebesucher Add-on installieren"
    CloseButtonText="Schließen"
    DefaultButton="Close"
    Style="{StaticResource DefaultContentDialogStyle}"
    RequestedTheme="Dark">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Wähle einen Browser aus, um das Add-on zu installieren oder zu deinstallieren."
                   TextWrapping="Wrap" Margin="0,0,0,20"/>

        <ItemsControl Grid.Row="1" ItemsSource="{x:Bind InstallAddOnViewModel.Browsers, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BrowserAddonStatusViewModel">

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Image Source="{x:Bind IconPath, Mode=OneWay}" 
                               Width="32" Height="32" 
                               VerticalAlignment="Center" Margin="0,0,15,0"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind InstallStatusText, Mode=OneWay}"
                                       Foreground="{x:Bind InstallStatusColor, Mode=OneWay}"
                                       FontSize="14" Margin="0,0,0,4"/>

                            <TextBlock Text="{x:Bind AddonStatusText, Mode=OneWay}"
                                       Foreground="{x:Bind AddonStatusColor, Mode=OneWay}"
                                       FontSize="14"/>
                        </StackPanel>

                        <Button Grid.Column="2" 
                                Content="{x:Bind ButtonText, Mode=OneWay}"
                                Command="{x:Bind OpenStoreCommand}"
                                IsEnabled="{x:Bind IsButtonEnabled, Mode=OneWay}"
                                HorizontalAlignment="Stretch" 
                                VerticalAlignment="Center"
                                Margin="10,0"/>

                        <TextBlock Grid.Column="3" 
                                   Text="{x:Bind AddonStatusIcon, Mode=OneWay}"
                                   Foreground="{x:Bind AddonStatusColor, Mode=OneWay}"
                                   FontSize="24" FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Width="30" TextAlignment="Center"/>

                    </Grid>

                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</ContentDialog>
