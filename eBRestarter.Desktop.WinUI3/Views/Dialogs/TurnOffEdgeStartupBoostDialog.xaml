<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="eBRestarter.Desktop.WinUI3.Views.Dialogs.TurnOffEdgeStartupBoostDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    mc:Ignorable="d"
    x:Uid="StartupBoostDialog"
    DefaultButton="Close"
    Style="{StaticResource DefaultContentDialogStyle}"
    RequestedTheme="Dark">

    <Grid MaxWidth="500">
        <StackPanel Spacing="20">

            <StackPanel Orientation="Horizontal" Spacing="15">
                <Image Source="ms-appx:///Resources/Visuals/Icons/Intersection/fa_edge.png"
                       Width="48" Height="48" VerticalAlignment="Top"/>
                <TextBlock x:Uid="StartupBoostDialog_InfoText"
                           Text="Wenn du den Startup-Boost deaktivieren willst..."
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Style="{StaticResource BodyTextBlockStyle}"/>
            </StackPanel>

            <MenuFlyoutSeparator/>

            <StackPanel Spacing="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="15" CornerRadius="8">

                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE945;" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                    <TextBlock x:Uid="StartupBoostDialog_OptionAuto_Header" FontWeight="Bold" Text="1. Automatisch (Registry)"/>
                </StackPanel>

                <TextBlock x:Uid="StartupBoostDialog_OptionAuto_Desc" 
                           Opacity="0.7" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,5"/>

                <ToggleSwitch x:Uid="StartupBoostDialog_SwitchStatus"
                              IsOn="{Binding IsStartupBoostEnabled, Mode=TwoWay}"
                              HorizontalAlignment="Stretch"/>

                <InfoBar IsOpen="{Binding IsInfoBarOpen, Mode=TwoWay}"
                         Title="{Binding InfoBarTitle}"
                         Message="{Binding InfoBarMessage}"
                         Severity="{Binding InfoBarSeverity}"
                         IsClosable="True"
                         Margin="0,10,0,0"/>

            </StackPanel>

            <StackPanel Spacing="10" Padding="10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE8C8;"/>
                    <TextBlock x:Uid="StartupBoostDialog_OptionManual_Header" FontWeight="Bold" Text="2. Manuell"/>
                </StackPanel>

                <TextBlock x:Uid="StartupBoostDialog_OptionManual_Desc" 
                           
                           Opacity="0.7" TextWrapping="Wrap" FontSize="12"/>

                <TextBox x:Uid="StartupBoostDialog_LinkText"
                         Text="edge://settings/?search=Startup-Boost"
                         IsReadOnly="True"
                         FontFamily="Consolas"/>

                <Button x:Uid="StartupBoostDialog_BtnCopy"
                        Command="{Binding CopyAndOpenEdgeCommand}"
                        
                        HorizontalAlignment="Stretch"/>
                
            </StackPanel>

        </StackPanel>
    </Grid>
</ContentDialog>