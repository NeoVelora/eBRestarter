<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="eBRestarter.Views.Dialogs.DeleteBrowserContentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:convertersNuget="using:CommunityToolkit.WinUI.Converters"
    mc:Ignorable="d"
    Title="Browser Daten bereinigen"
    CloseButtonText="Schließen" 
    DefaultButton="Close"
    Style="{StaticResource DefaultContentDialogStyle}"
    RequestedTheme="Dark">

    <ContentDialog.Resources>
        <convertersNuget:BoolNegationConverter x:Key="BoolNegationConverter"/>
        <convertersNuget:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>

        <convertersNuget:BoolToVisibilityConverter x:Key="InverseBoolToVisConverter" 
                                              TrueValue="Collapsed" 
                                              FalseValue="Visible"/>

        <Style TargetType="TextBlock" x:Key="HeaderTextStyle">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Foreground" Value="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
        </Style>
        
    </ContentDialog.Resources>

    <Grid MinWidth="500">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,25">
            <Image Source="{x:Bind ViewModel.BrowserIconPath, Mode=OneWay}"
                   Width="32" Height="32"
                   VerticalAlignment="Center"/>

            <TextBlock Text="{x:Bind ViewModel.BrowserName, Mode=OneWay}"
                       FontSize="20"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="15,0,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,25">
            <TextBlock Text="Verfügbare Optionen" Style="{StaticResource HeaderTextStyle}"/>

            <CheckBox Content="Lösche Cookies"
                      IsChecked="{x:Bind ViewModel.IsDeleteCookiesChecked, Mode=TwoWay}"
                      IsEnabled="{x:Bind ViewModel.IsBusy, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}"
                      Margin="0,0,0,10"/>

            <CheckBox Content="Lösche Internetcache"
                      IsChecked="{x:Bind ViewModel.IsDeleteInternetCacheChecked, Mode=TwoWay}"
                      IsEnabled="{x:Bind ViewModel.IsBusy, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,25">
            <TextBlock Text="Löschfortschritt" Style="{StaticResource HeaderTextStyle}"/>

            <Grid Margin="0,0,0,5">
                <ProgressBar Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}"
                             Maximum="{x:Bind ViewModel.ProgressMaximum, Mode=OneWay}"
                             Height="10"
                             IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay}"/>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           FontSize="12"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           ToolTipService.ToolTip="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}"
                           FontWeight="Bold"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"/>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,10,0,0">

            <Button Content="Ausgewählte Inhalte löschen"
                    Command="{x:Bind ViewModel.StartCleaningCommand}"
                    Visibility="{x:Bind ViewModel.IsBusy, Converter={StaticResource InverseBoolToVisConverter}, Mode=OneWay}"
                    HorizontalAlignment="Stretch"
                    Background="{ThemeResource SystemFillColorSuccessBrush}"
                    Foreground="White"/>

            <Button Content="Löschvorgang stoppen"
                    Command="{x:Bind ViewModel.CancelCleaningCommand}"
                    Visibility="{x:Bind ViewModel.IsBusy, Converter={StaticResource BoolToVisConverter}, Mode=OneWay}"
                    HorizontalAlignment="Stretch"
                    Background="{ThemeResource SystemFillColorCriticalBrush}"
                    Foreground="White"/>
        </Grid>

    </Grid>
</ContentDialog>
