<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="eBRestarter.Desktop.WinUI3.Views.Dialogs.AutoLogonDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Automatische Anmeldung konfigurieren"
    PrimaryButtonText="Speichern"
    SecondaryButtonText="Deaktivieren"
    CloseButtonText="Abbrechen"
    DefaultButton="Primary"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ContentDialog.Resources>
        
        <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        
        <Style TargetType="PasswordBox" BasedOn="{StaticResource DefaultPasswordBoxStyle}">
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        
    </ContentDialog.Resources>

    <Grid MinWidth="350">
        
        <StackPanel Spacing="0">
            
            <InfoBar Severity="Warning" 
                     IsOpen="True" 
                     IsClosable="False"
                     Title="Sicherheitshinweis"
                     Message="Das Kennwort wird verschlüsselt gespeichert. Der PC wird beim Starten jedoch nicht gesperrt sein."
                     Margin="0,0,0,20"/>

            <TextBox x:Name="TxtUsername" 
                     Header="Benutzername" 
                     PlaceholderText="Nutzername eingeben"/>

            <TextBox x:Name="TxtDomain" 
                     Header="Domäne (Optional)" 
                     PlaceholderText="Leer lassen für lokalen User"/>

            <PasswordBox x:Name="PbPassword"
                         Header="Kennwort"
                         PlaceholderText="Windows Kennwort eingeben"
                         PasswordRevealMode="Peek"/>
        </StackPanel>
        
    </Grid>
    
</ContentDialog>
