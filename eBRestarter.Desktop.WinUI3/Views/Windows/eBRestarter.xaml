<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="eBRestarter.Desktop.WinUI3.EBRestarter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:eBRestarter.Desktop.WinUI3"
    xmlns:usercontrol="using:eBRestarter.Desktop.WinUI3.Views.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"   
    mc:Ignorable="d"
    Title="eBRestarter.Desktop.WinUI3">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="{ThemeResource MenuBackgroundColor}">

        <Grid.Resources>
            <!-- Eigene Farben -->
            <SolidColorBrush x:Key="NavBackgroundBrush" Color="Black" />
            <SolidColorBrush x:Key="NavTextForegroundBrush" Color="Black" />
            <SolidColorBrush x:Key="NavDividerBrush" Color="Black" />
        </Grid.Resources>

        <!-- Card-Optik für das Menü -->
        <Border Margin="0,30,0,0"
                CornerRadius="0"
                Background="{ThemeResource MenuBackgroundColor}">
            
            <NavigationView x:Name="NavView"
                            Margin="0,0,0,0"
                            IsSettingsVisible="True"
                            PaneDisplayMode="Left"
                            IsPaneOpen="True"
                            CompactPaneLength="56"
                            OpenPaneLength="260"
                            Background="{ThemeResource MenuBackgroundColor}"
                            PaneToggleButtonStyle="{StaticResource CustomPaneToggleButtonStyle}"
                            SelectionChanged="NavView_SelectionChanged"
                            ItemInvoked="NavView_ItemInvoked">

                
                <!-- Header oben im Pane -->
                <NavigationView.PaneHeader>
                    
                    <StackPanel Orientation="Horizontal"
                                Margin="12,16,12,8">

                        <FontIcon Glyph="&#xE895;"
                                  FontSize="20"
                                  Foreground="Black"/>
                        
                        <TextBlock Text="eBRestarter"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="Black"/>
                        
                    </StackPanel>
                    
                </NavigationView.PaneHeader>

                <!-- Footer unten im Pane -->
                <NavigationView.PaneFooter>
                    
                    <StackPanel Margin="12,0,12,12">
                        
                        <Border Height="1"
                                Margin="0,0,0,8"
                                Background="{StaticResource NavDividerBrush}" />
                        
                        <TextBlock Text="v1.0.0"
                                   Opacity="0.6"
                                   FontSize="12"
                                   Foreground="Black" />
                        
                    </StackPanel>
                    
                </NavigationView.PaneFooter>

                <!-- Menüeinträge -->
                <NavigationView.MenuItems>

                    <NavigationViewItem Content="Übersicht"
                                        Tag="CommonOverview">

                        <NavigationViewItem.Icon>
                            
                            <FontIcon Glyph="&#xE7F4;"
                                      FontFamily="Segoe MDL2 Assets"
                                      />
                            
                        </NavigationViewItem.Icon>

                    </NavigationViewItem>

                    <NavigationViewItem Content="Restarter Properties"
                                        Tag="RestarterProperties">

                        <NavigationViewItem.Icon>

                            <FontIcon Glyph="&#xECA5;"
                                      FontFamily="Segoe MDL2 Assets"/>

                        </NavigationViewItem.Icon>

                    </NavigationViewItem>

                    <NavigationViewItem Content="Optionen"
                                        Tag="Options">

                        <NavigationViewItem.Icon>

                            <FontIcon Glyph="&#xF2C7;"
                                      FontFamily="Segoe Fluent Icons" />

                        </NavigationViewItem.Icon>

                    </NavigationViewItem>

                    <NavigationViewItem Content="Infocenter"
                                        Tag="Infocenter">

                        <NavigationViewItem.Icon>

                            <FontIcon Glyph="&#xE946;"
                                      FontFamily="Segoe Fluent Icons" />

                        </NavigationViewItem.Icon>

                    </NavigationViewItem>

                </NavigationView.MenuItems>

                <!-- INHALT RECHTS NEBEN DEM HAMBURGER-MENÜ -->
                <Grid>
                    
                    <Grid.RowDefinitions>
                        
                        <!-- oben: Leiste -->
                        <RowDefinition Height="*" />
                        
                        <!-- unten: eigentlicher Frame-Inhalt -->
                        <RowDefinition Height="auto" />
                        
                    </Grid.RowDefinitions>

                    <!-- Frame für den eigentlichen Seiteninhalt -->
                    <Frame Grid.Row="0"
                           x:Name="NavigationFrame" />

                    <!-- Leiste oben -->
                    <StackPanel Grid.Row="1"                                
                                Orientation="Horizontal"
                                Margin="0"
                                HorizontalAlignment="Stretch"
                                Background="White">

                        <usercontrol:UC_RestartTask Margin="5" />

                        <usercontrol:UC_DeleteBrowserContentTask Margin="5"/>

                    </StackPanel>

                </Grid>

            </NavigationView>
            
        </Border>
        
    </Grid>

</Window>
