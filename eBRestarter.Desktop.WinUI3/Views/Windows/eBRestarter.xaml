<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="eBRestarter.Desktop.WinUI3.EBRestarter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:eBRestarter.Desktop.WinUI3"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="eBRestarter.Desktop.WinUI3">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>

        <Grid.Resources>
            <!-- Eigene Farben -->
            <SolidColorBrush x:Key="NavBackgroundBrush" Color="#202536" />
            <SolidColorBrush x:Key="NavItemForegroundBrush" Color="#F5F5F5" />
            <SolidColorBrush x:Key="NavDividerBrush" Color="#44FFFFFF" />

            <!-- Nur ein leichtes Style-Tuning für NavigationViewItem -->
            <Style TargetType="NavigationViewItem">
                <Setter Property="Margin" Value="8,4" />
                <Setter Property="Foreground" Value="{StaticResource NavItemForegroundBrush}" />
            </Style>

            <!-- Presenter stylen, Template aber nicht ersetzen -->
            <Style TargetType="NavigationViewItemPresenter">
                <!-- „Pill“-Form & etwas mehr Platz -->
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
        </Grid.Resources>

        <!-- Card-Optik für das Menü -->
        <Border Margin="12"
        CornerRadius="12"
        Background="{StaticResource NavBackgroundBrush}">
            <NavigationView x:Name="NavView"
                    IsSettingsVisible="True"
                    PaneDisplayMode="Left"
                    IsPaneOpen="True"
                    CompactPaneLength="56"
                    OpenPaneLength="260"
                    Background="Transparent"
                    SelectionChanged="NavView_SelectionChanged"
                    ItemInvoked="NavView_ItemInvoked">

                <!-- Optionaler Header -->
                <NavigationView.PaneHeader>
                    <StackPanel Orientation="Horizontal" Margin="12,16,12,8">
                        <FontIcon Glyph="&#xE7C3;" FontSize="20" />
                        <TextBlock Text="eBRestarter"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource NavItemForegroundBrush}" />
                    </StackPanel>
                </NavigationView.PaneHeader>

                <!-- Optionaler Footer -->
                <NavigationView.PaneFooter>
                    <StackPanel Margin="12,0,12,12">
                        <Border Height="1"
                        Margin="0,0,0,8"
                        Background="{StaticResource NavDividerBrush}" />
                        <TextBlock Text="v1.0.0"
                           Opacity="0.6"
                           FontSize="12"
                           Foreground="{StaticResource NavItemForegroundBrush}" />
                    </StackPanel>
                </NavigationView.PaneFooter>

                <NavigationView.MenuItems>
                    <NavigationViewItem Content="Übersicht"
                                Tag="CommonOverview"
                                Icon="Home" />
                    <NavigationViewItem Content="Restarter Properties"
                                Tag="RestarterProperties"
                                Icon="Edit" />
                    <NavigationViewItem Content="Optionen"
                                Tag="Options"
                                Icon="Setting" />
                    <NavigationViewItem Content="Infocenter"
                                Tag="Infocenter"
                                Icon="Help" />
                </NavigationView.MenuItems>

                <Frame x:Name="NavigationFrame" />
            </NavigationView>
        </Border>
    </Grid>


    <!--<Grid>
        <NavigationView x:Name="NavView"
                        IsSettingsVisible="True"
                        SelectionChanged="NavView_SelectionChanged"
                        ItemInvoked="NavView_ItemInvoked">

            <NavigationView.MenuItems>
