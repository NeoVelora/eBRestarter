<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="eBRestarter.Desktop.WinUI3.EBRestarter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:eBRestarter.Desktop.WinUI3"
    xmlns:usercontrol="using:eBRestarter.Desktop.WinUI3.Views.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    Title="eBRestarter.Desktop.WinUI3">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="{ThemeResource MenuBackgroundColor}" >
        
        <Grid.RowDefinitions>
            
            <RowDefinition Height="Auto" />
            <!-- TitleBar -->
            <RowDefinition Height="*" />
            <!-- NavigationView -->
            
        </Grid.RowDefinitions>

        <!--  TITLE BAR wie in der Gallery  -->
        <controls:TitleBar x:Name="AppTitleBar"
                           x:Uid="AppTitleBar"
                           Grid.Row="0"
                           Foreground="{ThemeResource FontColor_1}"
                           IsBackButtonVisible="false"
                           IsBackButtonEnabled="{x:Bind NavigationFrame.CanGoBack, Mode=OneWay}"
                           BackRequested="AppTitleBar_BackRequested"
                           IsPaneToggleButtonVisible="True"
                           PaneToggleRequested="AppTitleBar_PaneToggleRequested">

            <controls:TitleBar.IconSource>
                
                <FontIconSource Glyph="&#xE895;"
                                Foreground="{ThemeResource FontColor_1}"/>
                
            </controls:TitleBar.IconSource>

        </controls:TitleBar>

        <!--  NavigationView darunter  SelectionChanged="NavView_SelectionChanged"-->
        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        IsSettingsVisible="True"
                        PaneDisplayMode="Left"
                        IsPaneOpen="True"
                        CompactPaneLength="56"
                        OpenPaneLength="260"
                        Background="{ThemeResource MenuBackgroundColor}"
                        PaneToggleButtonStyle="{StaticResource CustomPaneToggleButtonStyle}"
                        
                        ItemInvoked="NavView_ItemInvoked"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False">

                <!-- Footer unten im Pane -->
                <NavigationView.PaneFooter>
                    
                    <StackPanel Margin="12,0,12,12">
                        
                        <Border Height="1"
                                Margin="0,0,0,8"
                                Background="{ThemeResource FontColor_1}" />
                        
                        <TextBlock Text="v1.0.0"
                                   Opacity="0.6"
                                   FontSize="12"
                                   Foreground="{ThemeResource FontColor_1}" />
                        
                    </StackPanel>
                    
                </NavigationView.PaneFooter>

                <!-- Menüeinträge -->
                <NavigationView.MenuItems>

                <NavigationViewItem x:Uid="GeneralOverviewNavigation"
                                        Tag="CommonOverview">

                        <NavigationViewItem.Icon>
                            
                            <FontIcon Glyph="&#xE7F4;"
                                      FontFamily="Segoe MDL2 Assets"/>
                            
                        </NavigationViewItem.Icon>

                    </NavigationViewItem>

                <NavigationViewItem x:Uid="PropertiesNavigation"
                                    Tag="RestarterProperties">

                        <NavigationViewItem.Icon>

                            <FontIcon Glyph="&#xECA5;"
                                      FontFamily="Segoe MDL2 Assets"/>

                        </NavigationViewItem.Icon>

                    </NavigationViewItem>

                <NavigationViewItem x:Uid="OptionsNavigation"
                                    Tag="Options">

                        <NavigationViewItem.Icon>

                            <FontIcon Glyph="&#xF2C7;"
                                      FontFamily="Segoe Fluent Icons" />

                        </NavigationViewItem.Icon>

                    </NavigationViewItem>

                <NavigationViewItem x:Uid="InfocenterNavigation"
                                    Content="Infocenter"
                                    Tag="Infocenter">

                        <NavigationViewItem.Icon>

                            <FontIcon Glyph="&#xE946;"
                                      FontFamily="Segoe Fluent Icons" />

                        </NavigationViewItem.Icon>

                    </NavigationViewItem>

                </NavigationView.MenuItems>

            <!-- INHALT RECHTS NEBEN DEM HAMBURGER-MENÜ -->
            <Grid>
                
                <Grid.RowDefinitions>
                    
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    
                </Grid.RowDefinitions>

                <Frame Grid.Row="0"
                       x:Name="NavigationFrame" />

                <usercontrol:UC_RestartAgent Grid.Row="1"/>

            </Grid>

        </NavigationView>
                 
    </Grid>

</Window>

