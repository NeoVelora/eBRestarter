<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="eBRestarter.Desktop.WinUI3.Views.UserControls.UC_Browser"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:eBRestarter.Desktop.WinUI3.Views.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisInverted" TrueValue="Collapsed" FalseValue="Visible"/>
    </UserControl.Resources>
    
    <StackPanel>

        <Border x:Name          ="Border_Browser"
                Background      ="{ThemeResource DashletBackgroundColor_1}"              
                Margin          ="0, 0 ,0, 0"
                Height          ="80"
                Width           ="260"
                BorderThickness ="1"
                CornerRadius    ="5"
                Padding         ="0">

            <Canvas>

                <!--<ToggleButton x:Name              ="BtnDownloadBrowser"                                        
                              Content             ="Download"
                              HorizontalAlignment ="Center"
                              Height              ="80"
                              Width               ="80"
                              Visibility          ="{Binding DownloadToggleButtonVisible}"
                              Canvas.Top          ="-1"
                              Canvas.Left         ="-1"/>-->

                <Button x:Name="BtnDownloadBrowser"
                        Command="{Binding ToggleDownloadCommand}"
                        Content="{Binding DownloadButtonContent, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                        Foreground="{ThemeResource FontColor_1}" 
                        
                        Width="80"
                        Height="80"
                        HorizontalAlignment="Left"
                        Canvas.Top="-1" Canvas.Left="-1">
                </Button>

                <!--<Button x:Name              ="BtnChooseBrowser"
                        Command             ="{Binding ChooseBrowserCommand}"
                        Style               ="{StaticResource ButtonChooseBrowser}"
                        Content             ="Auswählen"
                        FontSize            ="11"
                        Height              ="80"
                        Width               ="80"
                        Visibility          ="{Binding ChooseBrowserButtonVisible}"
                        Canvas.Top          ="-1"
                        Canvas.Left         ="-1"/>-->

                <Image Name                            ="uc_browser_image"
                       Source                          ="{Binding HeaderImageBrowser}"
                       Height                          ="{Binding ImageSizeHeightBrowser}"
                       Width                           ="{Binding ImageSizeWidthBrowser}"
                       Canvas.Left                     ="85"
                       Canvas.Top                      ="5"
                       HorizontalAlignment             ="Left"
                       VerticalAlignment               ="Center"/>

                <TextBlock x:Name               ="tbl_Browser_name"
                           Foreground           ="{ThemeResource FontColor_1}"                         
                           TextWrapping         ="Wrap"
                           Text                 ="{Binding HeaderTitleBrowser}"
                           Canvas.Left          ="122"
                           Canvas.Top           ="6"
                           FontSize             ="16" 
                           HorizontalAlignment  ="Left"
                           VerticalAlignment    ="Center"/>

                <!--<TextBlock x:Name       ="tbl_BrowserVersion"
                           Foreground   ="{ThemeResource FontColor_1}"
                           Canvas.Left  ="86"
                           TextWrapping ="Wrap"
                           Text         ="{Binding BrowserVersion}"
                           Canvas.Top   ="57"
                           FontSize     ="14"/>

                <TextBlock x:Name       ="tbl_BrowserExist"
                           Canvas.Left  ="234"
                           TextWrapping ="Wrap"
                           Text         ="{Binding BrowserExist}"
                           Foreground   ="{Binding BrowserExistTextForground}"
                           FontSize     ="25"
                           Canvas.Top   ="-1"/>-->

                <ProgressBar x:Name="progressBarDownload"
                             Value="{Binding DownloadProgressValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Background="Black"
                             Height="14" Width="168"
                             Canvas.Left="85"
                             Canvas.Top="41"/>

                <TextBlock x:Name="tbl_DownloadSize"
                       Text="{Binding DownloadSizeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       
                       Canvas.Left="86" Canvas.Top="57" FontSize="14" Foreground="{ThemeResource FontColor_1}"/>

            </Canvas>

        </Border>

    </StackPanel>
    
</UserControl>
