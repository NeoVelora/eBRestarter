<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="eBRestarter.Desktop.WinUI3.Views.UserControls.UC_CommonOverview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:eBRestarter.Desktop.WinUI3.Views.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:VM="using:eBRestarter.Desktop.WinUI3.ViewModels"
    d:DataContext  ="{d:DesignInstance Type=VM:ViewModelGeneralOverview}"
    mc:Ignorable="d">

    <Grid x:Name="Root"
          Background="{ThemeResource MenuBackgroundColor_2}"
          CornerRadius="8,0,0,0">

        <!-- Header + Content -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0"
              Height="40"
              Background="{ThemeResource MenuBackgroundColor_3}">


            <StackPanel Background="{ThemeResource MenuBackgroundColor_3}"
                        Orientation="Horizontal"
                        Height="35"           
                        VerticalAlignment="Center"
                        Spacing="10"
                        Padding="10,0,0,0">

                <FontIcon Glyph="&#xE7F4;"
                          FontFamily="Segoe MDL2 Assets"
                          Foreground="{ThemeResource FontColor_1}"
                          FontSize="26"
                          VerticalAlignment="Bottom"/>

                <TextBlock x:Name="tbl_MainWindowTitle"
                           x:Uid="GeneralOverview"
                           Foreground="{ThemeResource FontColor_1}"
                           Margin="0,6,0,0"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="Bold"/>
            </StackPanel>

        </Grid>

        <!-- CONTENT -->
        <ScrollViewer Grid.Row="1"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">

            <!-- Gesamt-Layout: links Inhalt, rechts Sidebar -->
            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <!-- Links flexibel -->
                    <ColumnDefinition Width="*" MaxWidth="1200"/>
                    <!-- Abstand -->
                    <ColumnDefinition Width="12"/>
                    <!-- Rechts Sidebar fix -->
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- LINKS -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Card: Titel + Timer -->
                    <Border Grid.Row="0"
                        Background="{ThemeResource DashletBackgroundColor_2}"
                        CornerRadius="12"
                        BorderThickness="1"
                        BorderBrush="#22000000"
                        Padding="12"
                        Margin="0,0,0,12">

                        <StackPanel Orientation="Vertical"
                                HorizontalAlignment="Stretch"
                                Spacing="6">

                            <TextBlock Text="{Binding ChartTitle}"
                                   Foreground="{ThemeResource FontColor_1}"
                                   TextAlignment="Center"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>

                            <TextBlock x:Name="tblNextTimeOfEarningsRefresh"
                                   Foreground="{ThemeResource FontColor_1}"
                                   Text="{Binding ClockNextEarningsRefresh}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Opacity="0.85"
                                   HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Card: Chart / Output -->
                    <Border Grid.Row="1"
                            Background="{ThemeResource DashletBackgroundColor_2}"
                            CornerRadius="12"
                            BorderThickness="1"
                            BorderBrush="#22000000"
                            Padding="12"
                            Margin="0,0,0,12">

                        <!-- Control bleibt unverändert, nur Margin rausgenommen -->
                        <local:UC_PointsOutput Margin="0"/>
                    </Border>

                    <!-- Card: Earnings -->
                    <Border Grid.Row="2"
                            Background="{ThemeResource DashletBackgroundColor_2}"
                            CornerRadius="12"
                            BorderThickness="1"
                            BorderBrush="#22000000"
                            Padding="12">

                        <Grid ColumnSpacing="12"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Stretch">

                            <Grid.ColumnDefinitions>
                                
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                
                            </Grid.ColumnDefinitions>

                            <local:UC_EarningsAmount Grid.Column="0"
                                                     HeaderTitleEarnings="{Binding CurrentDay}"
                                                     HeaderImageEarnings="{ThemeResource ClockIcon}"
                                                     EarningsAmount="{Binding EarningsThisDaySum}"
                                                     Height="111"
                                                     HorizontalAlignment="Stretch"/>

                            <local:UC_EarningsAmount Grid.Column="1"
                                                     HeaderTitleEarnings="{Binding CurrentMonth}"
                                                     HeaderImageEarnings="{ThemeResource CalendarIcon}"
                                                     EarningsAmount="{Binding EarningsThisMonthSum}"
                                                     Height="111"
                                                     HorizontalAlignment="Stretch"/>

                            <local:UC_EarningsAmount Grid.Column="2"
                                                     HeaderTitleEarnings="{Binding CurrentYear}"
                                                     HeaderImageEarnings="{ThemeResource GlobeIcon4}"
                                                     EarningsAmount="{Binding EarningsThisYearSum}"
                                                     Height="111"
                                                     HorizontalAlignment="Stretch"/>

                        </Grid>
                        
                    </Border>
                    
                </Grid>

                <!-- RECHTS (Sidebar) -->
                <StackPanel Grid.Column="2"
                            HorizontalAlignment="Right"
                            Spacing="12">

                    <!-- Card: IP -->
                    <Border Background="{ThemeResource DashletBackgroundColor_2}"
                            CornerRadius="12"
                            BorderThickness="1"
                            BorderBrush="#22000000"
                            Padding="12">

                        <local:UC_IPInformation Height="280"
                                                Width="280"/>
                    </Border>

                    <!-- Card: Network -->
                    <Border Background="{ThemeResource DashletBackgroundColor_2}"
                        CornerRadius="12"
                        BorderThickness="1"
                        BorderBrush="#22000000"
                        Padding="12">

                        <local:UC_Networktraffic Height="228"
                                             Width="280"/>
                    </Border>

                    <!-- Card: Action Button -->
                    <Border Background="{ThemeResource DashletBackgroundColor_2}"
                        CornerRadius="12"
                        BorderThickness="1"
                        BorderBrush="#22000000"
                        Padding="12">

                        <Button x:Name="BtnGoToeVisitorAPI"
                            Click="BtnGoToeVisitorAPI_Click"
                            FontSize="16"
                            Height="55"
                            Width="276"
                            HorizontalAlignment="Center">

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Settings -->
                                <FontIcon Glyph="&#xE713;"
                                      VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="1"
                                           x:Uid="Go_to_API_options"
                                            VerticalAlignment="Center"/>

                                <!-- ChevronRight -->
                                <FontIcon Grid.Column="2"
                                      Glyph="&#xE72A;"
                                      VerticalAlignment="Center"
                                      Opacity="0.8"/>
                            </Grid>
                        </Button>
                    </Border>

                </StackPanel>

            </Grid>
        </ScrollViewer>
    </Grid>


</UserControl>
