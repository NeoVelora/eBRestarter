<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="eBRestarter.Desktop.WinUI3.Views.UserControls.UC_InformationsCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:eBRestarter.Desktop.WinUI3.Views.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Border
            Width="Auto"
            Height="140"
            Margin="0"
            Background="{x:Bind BackGroundColor, Mode=OneWay}"
            BorderThickness="0"
            CornerRadius="5">

            <StackPanel
                Width="Auto"
                Height="140"
                Orientation="Vertical">

                <StackPanel Height="40" Orientation="Horizontal">

                    <Image
                        Width="{x:Bind ImageWidth, Mode=OneWay}"
                        Height="{x:Bind ImageHeight, Mode=OneWay}"
                        Margin="10,0,0,0"
                        Source="{x:Bind HeaderImage, Mode=OneWay}" />

                    <TextBlock
                        Height="22"
                        Margin="10,0,0,0"
                        FontSize="16"
                        Foreground="{x:Bind TitleForeground, Mode=OneWay}"
                        Text="{x:Bind HeaderTitle, Mode=OneWay}" />

                </StackPanel>

                <TextBlock
                    Margin="15,7,0,0"
                    FontSize="16"
                    Foreground="{x:Bind InformationRowForeground, Mode=OneWay}"
                    Text="{x:Bind InformationRow1, Mode=OneWay}"
                    TextWrapping="Wrap" />

                <TextBlock
                    Margin="15,10,0,0"
                    FontSize="16"
                    Foreground="{x:Bind InformationRowForeground, Mode=OneWay}"
                    Text="{x:Bind InformationRow2, Mode=OneWay}" />

                <TextBlock
                    Margin="15,10,0,15"
                    FontSize="16"
                    Foreground="{x:Bind InformationRowForeground, Mode=OneWay}"
                    Text="{x:Bind InformationRow3, Mode=OneWay}" />

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
