<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="eBRestarter.Desktop.WinUI3.Views.UserControls.UC_InformationsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:eBRestarter.Desktop.WinUI3.Views.UserControls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>

        <Border     Name                        ="uc_information_backgroundcolor"                      
                    CornerRadius                ="5"
                    BorderThickness             ="0"                     
                    Width                       ="Auto"
                    Height                      ="140"
                    Margin                      ="0"
                    Background                  ="{Binding BackGroundColor}">

            <StackPanel Orientation         ="Vertical"
                    Width               ="Auto"
                    Height              ="140">

                <StackPanel     Height          ="40"
                            Orientation     ="Horizontal">

                    <Image
                            Name                            ="uc_information_header_image"
                            Source                          ="{Binding HeaderImage}"                               
                            Margin                          ="10,0,0,0"
                            Height                          ="{Binding ImageHeight}"
                            Width                           ="{Binding ImageWidth}"/>

                    <TextBlock  Name         ="uc_information_title"
                            Text         ="{Binding HeaderTitle}"
                            Foreground   ="{Binding Title_Foreground}"
                            Margin       ="10,0,0,0"
                            Height       ="22"
                            FontSize     ="16"/>

                </StackPanel>

                <TextBlock         Name             ="tbl_cpu_name"
                               Text             ="{Binding InformationRow_1}" 
                               Foreground       ="{Binding InformationRow_Foreground}"
                               FontSize         ="16"
                               Margin           ="15,7,0,0"
                               TextWrapping     ="Wrap"/>

                <TextBlock         Name             ="tbl_gpu_name"
                               Text             ="{Binding InformationRow_2}"
                               Foreground       ="{Binding InformationRow_Foreground}"
                               FontSize         ="16"
                               Margin           ="15,10,0,0"/>

                <TextBlock         Name             ="tbl_installed_RAM"
                               Text             ="{Binding InformationRow_3}"
                               Foreground       ="{Binding InformationRow_Foreground}"
                               FontSize         ="16"
                               Margin           ="15,10,0,15"/>

            </StackPanel>

        </Border>

    </Grid>
</UserControl>
