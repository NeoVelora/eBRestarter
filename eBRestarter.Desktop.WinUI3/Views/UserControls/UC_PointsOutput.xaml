<UserControl
    x:Class="eBRestarter.Desktop.WinUI3.Views.UserControls.UC_PointsOutput"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    xmlns:vm="using:eBRestarter.Desktop.WinUI3.ViewModels"
    mc:Ignorable="d">

    <Grid CornerRadius="8" 
          BorderThickness="1" 
          BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
          Background="{ThemeResource LayerFillColorDefaultBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="12,12,12,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding ChartTitle, Mode=OneWay}" 
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       VerticalAlignment="Center"/>

            <Pivot Grid.Column="1" 
                   SelectedIndex="{Binding SelectedPivotIndex, Mode=TwoWay}">
                <PivotItem Header="Heute" />
                <PivotItem Header="Monat" />
                <PivotItem Header="Jahr" />
            </Pivot>
        </Grid>

        <lvc:CartesianChart Grid.Row="1"
                            Margin="12"
                            MinHeight="250" 
                            Series="{Binding Series, Mode=OneWay}"
                            XAxes="{Binding XAxes, Mode=OneWay}"
                            YAxes="{Binding YAxes, Mode=OneWay}"
                            TooltipPosition="Top">
        </lvc:CartesianChart>

        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    Spacing="24" 
                    HorizontalAlignment="Center" 
                    Margin="0,0,0,16">

            <StackPanel>
                <TextBlock Text="Heute" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6"/>
                <TextBlock Text="{Binding EarningsThisDaySum, Mode=OneWay}" FontWeight="SemiBold"/>
            </StackPanel>

            <Border Width="1" Height="20" Background="Gray" Opacity="0.3"/>

            <StackPanel>
                <TextBlock Text="Diesen Monat" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6"/>
                <TextBlock Text="{Binding EarningsThisMonthSum, Mode=OneWay}" FontWeight="SemiBold"/>
            </StackPanel>

            <Border Width="1" Height="20" Background="Gray" Opacity="0.3"/>

            <StackPanel>
                <TextBlock Text="Dieses Jahr" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6"/>
                <TextBlock Text="{Binding EarningsThisYearSum, Mode=OneWay}" FontWeight="SemiBold"/>
            </StackPanel>
        </StackPanel>

    </Grid>
</UserControl>