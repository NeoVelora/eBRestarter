<UserControl
    x:Class="eBRestarter.Desktop.WinUI3.Views.UserControls.UC_PointsOutput"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    xmlns:vm="using:eBRestarter.Desktop.WinUI3.ViewModels"
    mc:Ignorable="d">

    <Grid CornerRadius="8" 
          BorderThickness="1" 
          Background="{ThemeResource DashletBackgroundColor_2}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="12,12,12,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Pivot Grid.Column="1"
                   SelectedIndex="{Binding SelectedPivotIndex, Mode=TwoWay}">

                <PivotItem>
                    
                    <PivotItem.Header>
                        
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            
                            <FontIcon Glyph="&#xE916;" FontSize="16" Foreground="Black"/>
                            <TextBlock Text="Heute" FontSize="14" Foreground="Black" VerticalAlignment="Center"/>
                            
                        </StackPanel>
                        
                    </PivotItem.Header>
                </PivotItem>

                <PivotItem>
                    
                    <PivotItem.Header>
                        
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            
                            <FontIcon Glyph="&#xE787;" FontSize="16" Foreground="Black"/>
                            <TextBlock Text="Monat" FontSize="14" Foreground="Black" VerticalAlignment="Center"/>
                            
                        </StackPanel>
                        
                    </PivotItem.Header>
                </PivotItem>

                <PivotItem>
                    
                    <PivotItem.Header>
                        
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            
                            <FontIcon Glyph="&#xE909;" FontSize="16" Foreground="Black"/>
                            <TextBlock Text="Jahr" FontSize="14" Foreground="Black" VerticalAlignment="Center"/>
                            
                        </StackPanel>
                        
                        
                    </PivotItem.Header>
                </PivotItem>

                
            </Pivot>
        </Grid>

        <Border CornerRadius="8"
                Grid.Row="1" 
                BorderThickness="1" 
                Margin="12"
                RequestedTheme="Light"
                Background="White">

            <lvc:CartesianChart 
                    CornerRadius="5"
                    Margin="12"
                    MinHeight="250"
                    RequestedTheme="Light"
                    Background="White"
                    Foreground="Black"
                    Series="{Binding Series, Mode=OneWay}"
                    XAxes="{Binding XAxes, Mode=OneWay}"
                    YAxes="{Binding YAxes, Mode=OneWay}"
                    TooltipPosition="Top">
            </lvc:CartesianChart>

        </Border>

        

    </Grid>
</UserControl>

