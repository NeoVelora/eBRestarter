<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="eBRestarter.Desktop.WinUI3.Views.UserControls.UC_RestartAgent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:VM="using:eBRestarter.Desktop.WinUI3.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:eBRestarter.Desktop.WinUI3.Views.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:usercontrol="using:eBRestarter.Desktop.WinUI3.Views.UserControls"
    d:DataContext="{d:DesignInstance Type=VM:ViewModelRestartTask}"
    mc:Ignorable="d">

    <Grid>

        <StackPanel
            HorizontalAlignment="Stretch"
            Background="{ThemeResource MenuBackgroundColor}"
            Orientation="Horizontal">

            <usercontrol:UC_RestartTask Margin="5" />

            <usercontrol:UC_DeleteBrowserContentTask Margin="5" />

        </StackPanel>

    </Grid>

</UserControl>
