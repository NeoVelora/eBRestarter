<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="eBRestarter.Desktop.WinUI3.Views.UserControls.UC_AdditionalOptions"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:eBRestarter.Desktop.WinUI3.Views.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border x:Name             ="Border_Additional_Options"
            Background         ="{ThemeResource DashletBackgroundColor_1}"
            BorderThickness    ="1"
            CornerRadius       ="2"
            Padding            ="0">

        <Canvas>

            <Image x:Name                       ="image_additional_options"
                   Source                       ="{ThemeResource CirclePlusIcon}"
                   Height                       ="32"
                   Canvas.Left                  ="11"
                   Canvas.Top                   ="10"
                   Width                        ="36"/>

            <TextBlock x:Name       ="tbl_AdditionalOptions"
                       Foreground   ="{ThemeResource FontColor_1}"
                       Canvas.Left  ="59"
                       TextWrapping ="Wrap"
                       Text         ="Zusatzoptionen"
                       Canvas.Top   ="13"
                       Width        ="135"
                       FontSize     ="18"/>

            <TextBlock x:Name               ="tbl_NoBrowserInstalled"                      
                       Canvas.Left          ="59"
                       TextWrapping         ="Wrap"
                       Text                 ="Keine Browser installiert!"
                       FontSize             ="16"
                       Foreground           ="#FFC70E3F"
                       HorizontalAlignment  ="Left"
                       VerticalAlignment    ="Top"
                       Canvas.Top           ="37"
                       Visibility           ="{Binding Tbl_NoBrowserInstalledIsVisible}"/>

            <Button x:Name          ="BtnDeleteBrowserContent"
                Content             ="Browserinhalte löschen"
                Canvas.Left         ="14"
                Canvas.Top          ="65"
                Width               ="295"
                Height              ="50"
                FontSize            ="16"
                HorizontalAlignment ="Center"
                VerticalAlignment   ="Top"
                IsEnabled           ="{Binding BtnDeleteBrowserContentIsEnabled}"/>

            <Button x:Name           ="BtnInstalleBesucherAddOn"                                    
                Content              ="Installiere eBesucher Add-on"
                Canvas.Left          ="14"
                Canvas.Top           ="127"
                Width                ="295"
                Height               ="40"
                FontSize             ="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                IsEnabled            ="{Binding BtnInstalleBesucherAddOnIsEnabled}"/>

            <Button x:Name               ="BtnInfoeVisitorAddOn"                                    
                Content              ="Wichtige Info zum Add-on"
                Canvas.Left          ="14"
                Canvas.Top           ="179"
                Width                ="295"
                Height               ="30"
                FontSize             ="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                IsEnabled            ="{Binding BtnInstalleBesucherAddOnIsEnabled}"/>

        </Canvas>

    </Border>
</UserControl>
