<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="eBRestarter.Desktop.WinUI3.Views.UserControls.UC_AdditionalOptions"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:eBRestarter.Desktop.WinUI3.Views.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border x:Name="Border_Additional_Options"
        Background="{ThemeResource DashletBackgroundColor_1}"
        BorderThickness="1"
        CornerRadius="5"
        Padding="10">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- Header: Icon + Titel -->
                <RowDefinition Height="Auto" />
                <!-- Hinweis-Text -->
                <RowDefinition Height="Auto" />
                <!-- Button 1 -->
                <RowDefinition Height="Auto" />
                <!-- Button 2 -->
                <RowDefinition Height="Auto" />
                <!-- Button 3 -->
            </Grid.RowDefinitions>


            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Margin="0,0,0,8">

                <Image x:Name="image_additional_options"
                       Source="{ThemeResource CirclePlusIcon}"
                       Height="28"
                       Width="28"
                       Margin="0,0,8,0" />

                <TextBlock x:Name="tbl_AdditionalOptions"
                           Foreground="{ThemeResource FontColor_1}"
                           TextWrapping="Wrap"
                           Text="Zusatzoptionen"
                           FontSize="18"
                           VerticalAlignment="Center" />
                
            </StackPanel>

        <TextBlock Grid.Row="1"
                   x:Name="tbl_NoBrowserInstalled"
                   Text="Keine Browser installiert!"
                   FontSize="16"
                   Foreground="#FFC70E3F"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"
                   Visibility="{Binding Tbl_NoBrowserInstalledIsVisible}" />


        <Button Grid.Row="2"
                x:Name="BtnDeleteBrowserContent"
                Content="Browserinhalte löschen"
                Style="{ThemeResource ButtonCustomStyle_1}"
                Margin="0,4,0,0"
                Height="40"
                FontSize="16"
                HorizontalAlignment="Stretch"
                IsEnabled="{Binding BtnDeleteBrowserContentIsEnabled}" />

        <Button Grid.Row="3"
                x:Name="BtnInstalleBesucherAddOn"
                Content="Installiere eBesucher Add-on"
                Style="{ThemeResource ButtonCustomStyle_1}"
                Margin="0,8,0,0"
                Height="40"
                FontSize="16"
                HorizontalAlignment="Stretch"
                IsEnabled="{Binding BtnInstalleBesucherAddOnIsEnabled}" />

        <Button Grid.Row="4"
                x:Name="BtnInfoeVisitorAddOn"
                Content="Wichtige Info zum Add-on"
                Style="{ThemeResource ButtonCustomStyle_1}"
                Margin="0,8,0,0"
                Height="30"
                FontSize="12"
                HorizontalAlignment="Stretch"
                IsEnabled="{Binding BtnInstalleBesucherAddOnIsEnabled}" />

        </Grid>
            
    </Border>

</UserControl>
