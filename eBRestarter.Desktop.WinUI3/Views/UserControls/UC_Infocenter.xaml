<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="eBRestarter.Desktop.WinUI3.Views.UserControls.UC_Infocenter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:eBRestarter.Desktop.WinUI3.Views.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="DP_MainWindows_Top"
      Background="{ThemeResource MenuBackgroundColor_2}"
      CornerRadius="8,0,0,0">

        <Grid.RowDefinitions>
            <!-- Top-Bar -->
            <RowDefinition Height="Auto" />
            <!-- Inhalt -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- OBERER BALKEN -->
        <StackPanel Grid.Row="0"
        Background="{ThemeResource MenuBackgroundColor_3}"
Orientation="Horizontal"
Height="35"
       
VerticalAlignment="Center"
Spacing="10"
Padding="10,0,0,0">

            <FontIcon Glyph="&#xE946;"
 
  Foreground="{ThemeResource FontColor_1}"
  FontSize="24"
  VerticalAlignment="Bottom"/>

            <TextBlock x:Name="tbl_MainWindowTitle"
   Foreground="{ThemeResource FontColor_1}"
                   Margin="0,7,0,0"
   Text="Infocenter"
   VerticalAlignment="Center"
   FontSize="18"
   FontWeight="Bold"/>

        </StackPanel>

        <!-- INHALT -->
        <ScrollViewer Grid.Row="1"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="160" />
                    <RowDefinition Height="180" />
                    <RowDefinition Height="160" />
                </Grid.RowDefinitions>

                <!-- ROW 0: zwei Info-Karten nebeneinander -->
                <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        Width="995">

                    <local:UC_InformationsCard HeaderTitle="Hardwarespezifiktion"
                                       TitleForeground="{ThemeResource FontColor_4}"
                                       HeaderImage="{ThemeResource WorkstationIcon}"
                                       ImageHeight="40"
                                       ImageWidth="40"
                                       BackGroundColor="{ThemeResource DashletBackgroundColor_4}"
                                       InformationRow1="{Binding HardwareSpecificationModel.Processor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       InformationRow2="{Binding HardwareSpecificationModel.Graphics,  Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       InformationRow3="{Binding HardwareSpecificationModel.Ram,       Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       InformationRowForeground="{ThemeResource FontColor_4}"
                                       Width="480"
                                       Margin="25,0,10,0" />

                    <local:UC_InformationsCard HeaderTitle="Windows-Spezifikation"
                                       TitleForeground="{ThemeResource FontColor_4}"
                                       HeaderImage="{ThemeResource WindowsIcon}"
                                       ImageHeight="25"
                                       ImageWidth="25"
                                       BackGroundColor="{ThemeResource DashletBackgroundColor_5}"
                                       InformationRow1="{Binding  WindowsInformationsModel.CurrentEdition,        Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       InformationRow2="{Binding  WindowsInformationsModel.CurrentOSVersion,      Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       InformationRow3="{Binding  WindowsInformationsModel.CurrentOSBuildVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       InformationRowForeground="{ThemeResource FontColor_4}"
                                       Width="480"
                                               />
                </StackPanel>

                <!-- ROW 1: URL-Karte -->
                <StackPanel Grid.Row="1"
                        Orientation="Horizontal">

                    <local:UC_InformationCardUrls Width="970"
                                          Margin="25,0,10,0" />
                </StackPanel>

                <!-- ROW 2: "Über eB Restarter"-Button -->
                <StackPanel Grid.Row="2"
                        Orientation="Vertical"
                        HorizontalAlignment="Left"
                        Margin="25,10,0,0">

                    <Button x:Name="Btn_about"
                        Style="{ThemeResource AccentButtonStyle}"
                        Width="968"
                        Height="63"
                        Margin="0"
                        Click="Btn_about_Click">

                        <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="-5,0,0,0">

                            <!-- Info-Icon (statt MD:PackIcon) -->
                            <FontIcon Glyph="&#xE946;"
                                  FontSize="20"
                                  Width="35"
                                  Height="30" />

                            <TextBlock Text="Über eB Restarter"
                                   FontSize="16"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                </StackPanel>

            </Grid>
        </ScrollViewer>

    </Grid>

</UserControl>
