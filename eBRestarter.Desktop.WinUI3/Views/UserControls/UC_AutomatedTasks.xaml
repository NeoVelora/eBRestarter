<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="eBRestarter.Desktop.WinUI3.Views.UserControls.UC_AutomatedTasks"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:eBRestarter.Desktop.WinUI3.Views.UserControls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:VM="using:eBRestarter.Desktop.WinUI3.ViewModels"
             d:DataContext  ="{d:DesignInstance Type=VM:ViewModelRestarterProperties}"
             mc:Ignorable="d">

    <Border x:Name          ="Border_Automated_Task"
            Background      ="{ThemeResource DashletBackgroundColor_1}"
            BorderThickness ="1"
            CornerRadius    ="5"
            Padding         ="0">

        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="50"/>
                <RowDefinition Height="120"/>
                <RowDefinition Height="80"/>

            </Grid.RowDefinitions>

            <StackPanel Grid.Row    ="0"
                        Orientation ="Horizontal">

                <Image x:Name ="image_automated_task"
                       Source ="{ThemeResource GearIcon}"
                       Margin ="10, 10, 0, 0"
                       Height ="35"
                       Width  ="35"/>

                <TextBlock x:Name       ="tbl_Automated_Task"
                           x:Uid        ="AutomatedTasks"
                           Foreground   ="{ThemeResource FontColor_1}"
                           Margin       ="10, 15, 0, 0"
                           TextWrapping ="Wrap"
                           Width        ="212"
                           FontSize     ="18"/>
            </StackPanel>


            <StackPanel Grid.Row="1"
                        Spacing="0">

                <ToggleSwitch x:Name          ="TSStartBrowserWithProgrammStart"
                              x:Uid           ="TSStartBrowserWithProgrammStart"
                              Foreground      ="{ThemeResource FontColor_1}"
                              IsOn            ="{Binding StartBrowserWithProgrammStartIs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Margin          ="10 0 0 0"
                              Width           ="304">

                    <!--<ToggleSwitch.Resources>
                        
                        --><!-- TRACK / HINTERGRUND: AUS --><!--
                        <SolidColorBrush x:Key="ToggleSwitchFillOff"               Color="#D2D5D6" />
                        <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver"    Color="#FF505050" />
                        <SolidColorBrush x:Key="ToggleSwitchFillOffPressed"        Color="#FF303030" />

                        --><!-- KNOPF: AUS --><!--
                        <SolidColorBrush x:Key="ToggleSwitchKnobFillOff"           Color="#FF00B894" />
                        <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#FF1ED3AE" />
                        <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed"    Color="#FF009973" />

                        --><!-- TRACK / HINTERGRUND: AN --><!--
                        <SolidColorBrush x:Key="ToggleSwitchFillOn"                Color="#FF00B894" />
                        <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver"     Color="#FF1ED3AE" />
                        <SolidColorBrush x:Key="ToggleSwitchFillOnPressed"         Color="#FF009973" />

                        --><!-- KNOPF: AN --><!--
                        <SolidColorBrush x:Key="ToggleSwitchKnobFillOn"            Color="White" />
                        <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="White" />
                        <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed"     Color="White" />


                        <SolidColorBrush x:Key="ToggleSwitchBackgroundFillOff"     Color="Black" />
                        
                        --><!-- optional: Ränder ausblenden --><!--
                        <SolidColorBrush x:Key="ToggleSwitchStrokeOff"             Color="#19aabd" />
                        <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver"  Color="Transparent" />
                        <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed"      Color="Transparent" />
                        <SolidColorBrush x:Key="ToggleSwitchStrokeOn"              Color="Transparent" />
                        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver"   Color="Transparent" />
                        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed"       Color="Transparent" />
                        
                    </ToggleSwitch.Resources>-->

                </ToggleSwitch>

                <ToggleSwitch x:Name          ="TSCheckBrowserIsAlive"
                              x:Uid           ="TSCheckBrowserIsAlive"
                              Foreground      ="{ThemeResource FontColor_1}"
                              IsOn            ="{Binding CheckBrowserIsAliveIsOn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Margin          ="10 0 0 0" />

                <HyperlinkButton Command="{Binding OpenStartupBoostDialogCommand}"
                                 Margin="10,0,0,0"
                                 Padding="0"
                                 HorizontalContentAlignment="Left">

                    <TextBlock x:Name="tbl_info_startup_boost_edge"
                               x:Uid="StartupEdgeBoost_Info"
                               FontSize="10"
                               Width="286"
                               Foreground="#FF008CD5"
                               TextWrapping="Wrap"
                               Height="40"/>

                </HyperlinkButton>

            </StackPanel>

            <ComboBox x:Name="ComboboxDeleteBrowserCache"
                      Grid.Row="2"
                      Margin="10,0,0,0"
                      PlaceholderText="Browser delete cache options" 
                      FontSize="14"
                      Width="294"
                      Height="40"
                      VerticalAlignment="Top"
                      SelectedIndex="0"
                      DisplayMemberPath="DisplayText"
                      RequestedTheme="{ThemeResource GeneralRequestedTheme}"
                      ItemsSource="{Binding BrowserDeleteCacheOptionList}"
                      SelectedItem="{Binding SelectedDeleteBrowserCacheOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">

                <!--<ComboBox.Resources>
                    --><!-- Normal --><!--
                    <SolidColorBrush x:Key="ComboBoxBackground" Color="#DCDCDC" />
                    <SolidColorBrush x:Key="ComboBoxForeground" Color="White" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="White" />

                    --><!-- Hover --><!--
                    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="Black" />
                    <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="White" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="White" />

                    --><!-- Pressed --><!--
                    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="Black" />
                    <SolidColorBrush x:Key="ComboBoxForegroundPressed" Color="White" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="White" />

                </ComboBox.Resources>-->

            </ComboBox>

        </Grid>

    </Border>

</UserControl>