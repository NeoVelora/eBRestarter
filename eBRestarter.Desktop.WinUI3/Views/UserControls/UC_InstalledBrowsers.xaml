<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="eBRestarter.Desktop.WinUI3.Views.UserControls.UC_InstalledBrowsers"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:userControls="using:eBRestarter.Desktop.WinUI3.Views.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel>

        <Border x:Name          ="Border_Installedbrowser"
                Background      ="{ThemeResource DashletBackgroundColor_1}"
                Margin          ="0, 0 ,0, 0"
                Height          ="40"
                Width           ="260"
                BorderThickness ="1"
                CornerRadius    ="5"
                Padding         ="0">

            <StackPanel Orientation="Horizontal">

                <Image x:Name                           ="image_installed_browsers"
                       Source                           ="{ThemeResource GlobeIcon}"
                       Margin                           ="5"
                       Height                           ="28"
                       Width                            ="auto"                                          
                       Canvas.Left                      ="5"
                       Canvas.Top                       ="5"/>

                <TextBlock x:Name       ="tbl_Installed_Browsers"
                           x:Uid        ="Installed_browser"
                           Foreground   ="{ThemeResource FontColor_1}"
                           FontSize     ="18"
                           Canvas.Left  ="39"
                           TextWrapping ="Wrap"
                           Height="24"/>

            </StackPanel>

        </Border>

        <ItemsControl ItemsSource="{Binding Browsers}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <userControls:UC_Browser DataContext="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        
        <!--<userControls:UC_Browser Margin="0,8,0,5" Height="auto"/>

        <userControls:UC_Browser Margin="0,7,0,5"/>

        <userControls:UC_Browser Margin="0,15,0,5"/>

        <userControls:UC_Browser Margin="0,7,0,5"/>-->

    </StackPanel>
</UserControl>
