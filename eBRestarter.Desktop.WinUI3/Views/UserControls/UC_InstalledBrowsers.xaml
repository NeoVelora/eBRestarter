<UserControl
    x:Class="eBRestarter.Desktop.WinUI3.Views.UserControls.UC_InstalledBrowsers"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:userControls="using:eBRestarter.Desktop.WinUI3.Views.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid CornerRadius="8"
          Background="{ThemeResource DashletBackgroundColor_1}"
          BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
          BorderThickness="1"
          Padding="4">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            
            <Grid.ColumnDefinitions>
                
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                
            </Grid.ColumnDefinitions>

            <Image x:Name="image_installed_browsers"
                   Source="{ThemeResource GlobeIcon}"
                   Height="24" Width="24"
                   VerticalAlignment="Center"
                   Margin="0,0,12,0"/>

            <TextBlock x:Name="tbl_Installed_Browsers"
                       Grid.Column="1"
                       x:Uid="Installed_browser"
                       Text="Installierte Browser" 
                       FontSize="18"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource FontColor_1}"/>

        </Grid>

        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalAlignment="Left">

            <ItemsControl ItemsSource="{Binding Browsers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <userControls:UC_Browser DataContext="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

        </ScrollViewer>
    </Grid>
</UserControl>