<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="eBRestarter.Desktop.WinUI3.Views.UserControls.UC_RestartAndRuntimeOptions"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:eBRestarter.Desktop.WinUI3.Views.UserControls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
             xmlns:behaviors="using:eBRestarter.Desktop.WinUI3.Behaviors"
             xmlns:VM="using:eBRestarter.Desktop.WinUI3.ViewModels"
             d:DataContext  ="{d:DesignInstance Type=VM:ViewModelRestarterProperties}"
             mc:Ignorable="d">

    <Border x:Name="Border_Restart_and_Runtime_Options"
            Background="{ThemeResource DashletBackgroundColor_1}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12">

        <Grid>

            <!-- 2 Spalten: links Text/Slider, rechts Wert + Einheit -->
            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*" />

                <ColumnDefinition Width="Auto" />

            </Grid.ColumnDefinitions>

            <!-- Zeilen dynamisch nach Inhalt -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="Auto" />
                <!-- Label 1 -->
                <RowDefinition Height="Auto" />
                <!-- Slider 1 -->
                <RowDefinition Height="Auto" />
                <!-- Label 2 -->
                <RowDefinition Height="Auto" />
                <!-- Slider 2 -->
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <StackPanel Grid.Row="0"
                        Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        Margin="0,0,0,8">

                <Image x:Name="image_restart_and_runtime_options"
                       Source="{ThemeResource ClockRotateIcon}"
                       Margin="0,2,0,0"
                       Height="25"
                       Width="30" />

                <TextBlock x:Name="tbl_Restart_and_Runtime_Option"
                           x:Uid="Restart_And_Runtime_Options"
                           Foreground="{ThemeResource FontColor_1}"
                           Margin="8,0,0,0"
                           FontSize="18"
                           VerticalAlignment="Center"/>

            </StackPanel>

            <!-- LABEL: Wartezeit bis der Browser wieder startet -->
            <TextBlock Grid.Row="1"
                       Grid.ColumnSpan="2"
                       x:Name="Tbl_waiting_time_until_the_browser_starts"
                       x:Uid="Waiting_time_until_the_browser_restarts"
                       Foreground="{ThemeResource FontColor_1}"
                       Margin="0,4,0,10"
                       FontSize="15" />

            <!-- SLIDER + WERT (Sekunden) -->
            <Slider Grid.Row="2"
                    Grid.Column="0"                       
                    x:Name="SliderBrowserWaitingTimeToStart"
                    Minimum="{Binding RuntimePauseSecondsMin, Mode=OneTime}"
                    Maximum="{Binding RuntimePauseSecondsMax, Mode=OneTime}"
                    Value="{Binding RuntimePauseSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Margin="0,4,12,5"
                    Height="30"
                    Width="115"
                    Background="Black"
                    Foreground="#FF00D4BC" 
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Left"/>

            <StackPanel Grid.Row="2"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <!--<TextBox x:Name="TxtB_Browser_Waiting_Time_To_Start"                      
                         MinWidth="50"
                         MaxWidth="70"
                         Margin="0,0,0,0"
                         FontSize="14"
                         TextAlignment="Left"
                         MaxLength="2"
                         KeyDown="TxtB_Browser_Waiting_Time_To_Start_KeyDown"
                         Foreground="{ThemeResource FontColor_1}"
                         BorderBrush="{ThemeResource FontColor_1}"
                         Text="{Binding RestMinutes, Mode=TwoWay, UpdateSourceTrigger=LostFocus}">

                    <interactivity:Interaction.Behaviors>
                        
                        <behaviors:TextBoxNumericOnlyBehavior />
                        
                    </interactivity:Interaction.Behaviors>
                    
                </TextBox>-->

                <NumberBox Value="{Binding RuntimePauseSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                           Width="150"
                           Minimum="20"
                           Maximum="60"
                           VerticalAlignment="Stretch"
                           HorizontalAlignment="Left"
                           Foreground="{ThemeResource FontColor_1}"
                           BorderBrush="{ThemeResource FontColor_1}"
                           SpinButtonPlacementMode="Inline"
                           SmallChange="1" />

                <TextBlock x:Name="tbl_restart_and_runtime_options_s"
                           Foreground="{ThemeResource FontColor_1}"
                           Margin="5,0,0,0"
                           Text="s"
                           FontSize="18"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- LABEL: Browserlaufzeit -->
            <TextBlock Grid.Row="3"
                       Grid.ColumnSpan="2"                      
                       x:Name="Tbl_set_your_browser_runtime"
                       x:Uid="Determine_your_browser_runtime_here"
                       Foreground="{ThemeResource FontColor_1}"
                       Margin="0,12,0,10"
                       FontSize="15"/>

            <!-- SLIDER + WERT (Stunden) -->
            <Slider Grid.Row="4"
                    Grid.Column="0"
                    x:Name="SliderBrowserRuntime"
                    Minimum="{Binding BrowserRuntimeHoursMin, Mode=OneTime}"
                    Maximum="{Binding BrowserRuntimeHoursMax, Mode=OneTime}"
                    Value="{Binding RuntimeHours, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Margin="0,4,12,10"
                    Height="30"
                    Width="115"
                    Background="Black"
                    Foreground="#FF00D4BC" 
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch"/>

            <StackPanel Grid.Row="4"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <!--<TextBox x:Name="Txt_Browser_Runtime"
                         MinWidth="50"
                         MaxWidth="70"
                         Margin="0,0,0,0"
                         FontSize="14"
                         TextAlignment="Left"
                         MaxLength="2"
                         Foreground="{ThemeResource FontColor_1}"
                         BorderBrush="{ThemeResource FontColor_1}"
                         Text="{Binding RuntimeHours, Mode=TwoWay, UpdateSourceTrigger=LostFocus}">

                    <interactivity:Interaction.Behaviors>

                        <behaviors:TextBoxNumericOnlyBehavior />

                    </interactivity:Interaction.Behaviors>

                </TextBox>-->

                <NumberBox Value="{Binding RuntimeHours, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                           Width="150"
                           Minimum="1"
                           Maximum="12"
                           VerticalAlignment="Stretch"
                           HorizontalAlignment="Left"
                           Foreground="{ThemeResource FontColor_1}"
                           BorderBrush="{ThemeResource FontColor_1}"
                           SpinButtonPlacementMode="Inline"
                           SmallChange="1" />

                <TextBlock x:Name="Tbl_restart_and_runtime_options_h"
                           Foreground="{ThemeResource FontColor_1}"
                           Margin="5,0,0,0"
                           Text="h"
                           FontSize="18"
                           VerticalAlignment="Center"/>
                
            </StackPanel>

        </Grid>

    </Border>

</UserControl>
