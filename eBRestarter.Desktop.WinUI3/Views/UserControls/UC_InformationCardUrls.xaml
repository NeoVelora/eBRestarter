<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="eBRestarter.Desktop.WinUI3.Views.UserControls.UC_InformationCardUrls"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:eBRestarter.Desktop.WinUI3.Views.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Border x:Name="Border_browser_downloadlinks"
            Grid.Row="1"
            CornerRadius="5"
            BorderThickness="0"
            Margin="0"
            Width="Auto"
            Height="140"
            Background="#FF3A485C">

            <StackPanel Width="Auto" Margin="0,5">

                <!-- Header -->
                <StackPanel Height="40"
                        Orientation="Horizontal"
                        Background="#FF3A485C">

                    <Image Source="{ThemeResource GlobeIcon3}"
                       Margin="10,0,0,0"
                       Height="25"
                       Width="25" />

                    <TextBlock x:Uid="Browser_download_links"
                               Height="25"
                               FontSize="16"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource FontColor_4}" />
                    
                </StackPanel>

                <!-- Links -->
                <HyperlinkButton Content="Chrome Download"
                             Command="{Binding OpenSupportWebsiteCommand}"
                             CommandParameter="https://www.google.com/chrome/"
                             Foreground="{ThemeResource FontColor_4}"
                             Background="Transparent"
                             HorizontalAlignment="Left"
                             Margin="15,7,0,0"
                             Padding="0" />

                <HyperlinkButton Content="Firefox Download"
                             Command="{Binding OpenSupportWebsiteCommand}"
                             CommandParameter="https://www.mozilla.org/de/firefox/new/"
                             Foreground="{ThemeResource FontColor_4}"
                             Background="Transparent"
                             HorizontalAlignment="Left"
                             Margin="15,7,0,0"
                             Padding="0" />

                <HyperlinkButton Content="Edge Download"
                             Command="{Binding OpenSupportWebsiteCommand}"
                             CommandParameter="https://www.microsoft.com/de-de/edge"
                             Foreground="{ThemeResource FontColor_4}"
                             Background="Transparent"
                             HorizontalAlignment="Left"
                             Margin="15,10,0,0"
                             Padding="0" />

            </StackPanel>
        </Border>
    </Grid>


</UserControl>
