<UserControl
    x:Class="eBRestarter.Desktop.WinUI3.Views.UserControls.UC_Networktraffic"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:eBRestarter.Desktop.WinUI3.Models.UI"
    mc:Ignorable="d">

    <Border BorderThickness="1"
            Background="{ThemeResource MenuBackgroundColor}"
            CornerRadius="2"
            Padding="0">

        <StackPanel>
            
            <StackPanel Height="46" Orientation="Horizontal">

                <Image Source="/Resources/Visuals/Icons/Intersection/globe-grid.png"
                       Height="32" Width="32"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Margin="5,0,0,0"/>

                <TextBlock x:Uid="NetworkTraffic"
                           Foreground="{ThemeResource FontColor_1}"
                           FontSize="20"
                           VerticalAlignment="Center"
                           Margin="5,0,0,0"/>
                
            </StackPanel>

            <Grid Height="180" Width="280" HorizontalAlignment="Center">
                
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">

                    <ItemsControl ItemsSource="{x:Bind ViewModelNetworkTraffic.NetworkCards, Mode=OneWay}">
                        
                        <ItemsControl.ItemTemplate>
                            
                            <DataTemplate x:DataType="models:NetworkCardDisplayModel">

                                <Grid Margin="0,0,0,15">
                                    
                                    <Grid.RowDefinitions>
                                        
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">

                                        <Image Source="{ThemeResource NetworkCardIcon}" 
                                               Width="23"
                                               Height="23"
                                               Margin="5,0,0,0"/>

                                        <TextBlock Text="{x:Bind AdapterName, Mode=OneWay}"
                                                   Foreground="{ThemeResource FontColor_1}"
                                                   Margin="5,0,0,0" FontSize="15"/>
                                        
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,5">

                                        <Image Source="{ThemeResource DownloadIcon}" Width="23" Height="23" Margin="5,0,0,0"/>
                                        
                                        <TextBlock Text="{x:Bind ReceivedData, Mode=OneWay}"
                                                   Foreground="{ThemeResource FontColor_1}"
                                                   Margin="5,0,0,0" FontSize="15"/>
                                        
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Orientation="Horizontal">

                                        <Image Source="{ThemeResource SendDataIcon}" Width="23" Height="23" Margin="5,0,0,0"/>
                                        
                                        <TextBlock Text="{x:Bind SentData, Mode=OneWay}"
                                                   Foreground="{ThemeResource FontColor_1}"
                                                   Margin="5,0,0,0" FontSize="15"/>
                                        
                                    </StackPanel>
                                    
                                </Grid>

                            </DataTemplate>
                            
                        </ItemsControl.ItemTemplate>
                        
                    </ItemsControl>
                    
                </ScrollViewer>
                
            </Grid>
            
        </StackPanel>
        
    </Border>
    
</UserControl>