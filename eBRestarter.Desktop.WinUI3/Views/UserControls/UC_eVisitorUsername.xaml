<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="eBRestarter.Desktop.WinUI3.Views.UserControls.UC_eVisitorUsername"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:VM="using:eBRestarter.Desktop.WinUI3.ViewModels"
    xmlns:behaviors="using:CommunityToolkit.WinUI.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:local="using:eBRestarter.Desktop.WinUI3.Views.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=VM:ViewModelRestarterProperties}"
    mc:Ignorable="d">

    <Border
        x:Name="Border_eVisitor_Username"
        Background="{ThemeResource DashletBackgroundColor_1}"
        BorderThickness="1"
        CornerRadius="5">

        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="50" />
                <RowDefinition Height="auto" />

            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">

                <Image
                    x:Name="image_eBVisitor_username"
                    Width="40"
                    Height="30"
                    Margin="15,5,0,0"
                    Source="{ThemeResource UserIcon}" />

                <TextBlock
                    x:Name="tbl_Username"
                    x:Uid="eVisitorUsername"
                    Height="27"
                    Margin="10,5,0,0"
                    FontSize="20"
                    Foreground="{ThemeResource FontColor_1}"
                    TextWrapping="Wrap" />

            </StackPanel>

            <StackPanel Grid.Row="1">

                <Button
                    x:Name="BtneVisitorRegistration"
                    x:Uid="RegisterWitheVisitor"
                    Width="279"
                    Height="35"
                    Margin="20,5,0,0"
                    HorizontalAlignment="Left"
                    BorderBrush="Transparent"
                    Command="{Binding RegisterToEVisitorCommand}"
                    FontSize="16" />

                <TextBlock
                    x:Name="tbl_PleaseEnterYourUsernameHere"
                    x:Uid="Please_Enter_Your_Username_Here"
                    Margin="20,10,0,0"
                    HorizontalAlignment="Left"
                    FontSize="14"
                    Foreground="{ThemeResource FontColor_1}" />

                <TextBox
                    x:Name="tb_PleaseEnterYourUsernameHere"
                    Width="280"
                    Height="35"
                    Margin="20,8,0,0"
                    HorizontalAlignment="Left"
                    AcceptsReturn="False"
                    BorderBrush="{ThemeResource TextBoxBottumBorderBrushBackgroundColor}"
                    FontSize="18"
                    Foreground="{ThemeResource FontColor_1}"
                    Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">

                    <interactivity:Interaction.Behaviors>
                        <behaviors:KeyDownTriggerBehavior Key="Enter">
                            <interactivity:InvokeCommandAction Command="{Binding AddEVisitorUsernameCommand}" />
                        </behaviors:KeyDownTriggerBehavior>
                    </interactivity:Interaction.Behaviors>

                </TextBox>


                <Button
                    x:Name="BtnUserNameApply"
                    x:Uid="Add"
                    Width="278"
                    Height="35"
                    Margin="21,10,0,0"
                    HorizontalAlignment="Left"
                    BorderBrush="Transparent"
                    Command="{Binding AddEVisitorUsernameCommand}"
                    FontSize="16"
                    Style="{ThemeResource ButtonCustomStyle_1}" />

            </StackPanel>

        </Grid>

    </Border>

</UserControl>
