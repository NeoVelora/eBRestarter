<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="eBRestarter.Desktop.WinUI3.Views.UserControls.UC_eVisitorUsername"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:eBRestarter.Desktop.WinUI3.Views.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border x:Name          ="Border_eVisitor_Username"
            Background      ="{ThemeResource DashletBackgroundColor_1}"
            BorderThickness ="1"
            CornerRadius    ="2">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Orientation="Horizontal">

                <Image x:Name                           ="image_eBVisitor_username"
                       Source                           ="{ThemeResource UserIcon}"
                       Margin                           ="20,5,0,0"
                       Height                           ="40"
                       Width                            ="43"/>

                <TextBlock x:Name       ="tbl_Username"
                           Foreground   ="{ThemeResource FontColor_1}"
                           Margin       ="10,5,0,0"
                           TextWrapping ="Wrap"
                           Text         ="eBesucher Nutzername"
                           FontSize     ="20"
                           Height       ="27"/>

            </StackPanel>

            <StackPanel Grid.Row="1">

                <Button x:Name              ="BtneVisitorRegistration"
                        Margin              ="20,5,0,0"
                        Style               ="{ThemeResource ButtonStyle}"           
                        BorderBrush         ="Transparent"
                        Content             ="Bei eBesucher registrieren" 
                        Height              ="35"
                        Width               ="279"
                        FontSize            ="16"
                        HorizontalAlignment ="Left"
                        Command             ="{Binding RegisterToEVisitorCommand}"/>

                <TextBlock x:Name               ="tbl_PleaseEnterYourUsernameHere"
                           Foreground           ="{ThemeResource FontColor_1}"
                           Margin               ="20,10,0,0"
                           Text                 ="Bitte gebe hier deinen Nutzernamen ein:"
                           FontSize             ="16"
                           HorizontalAlignment  ="Left"/>

                <TextBox x:Name                 ="tb_PleaseEnterYourUsernameHere"
                         Foreground             ="{ThemeResource FontColor_1}"
                         BorderBrush            ="{ThemeResource TextBoxBottumBorderBrushBackgroundColor}"
                         Text                   ="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Margin                 ="20,8,0,0"                        
                         Height                 ="35"
                         Width                  ="280"                        
                         FontSize               ="18"
                         HorizontalAlignment    ="Left"
                         AcceptsReturn          ="False">


                </TextBox>

                <Button x:Name              ="BtnUserNameApply"
                        Margin              ="21,10,0,0"
                        Command             ="{Binding ExecuteAddUsernameCommand}"
                        CommandParameter    ="{Binding ElementName=tb_PleaseEnterYourUsernameHere, Path=Text}"
                        BorderBrush         ="Transparent"
                        Content             ="Hinzufügen"
                        HorizontalAlignment ="Left"
                        Width               ="278"
                        Height              ="35"
                        FontSize            ="16"/>

            </StackPanel>

        </Grid>

    </Border>
</UserControl>
