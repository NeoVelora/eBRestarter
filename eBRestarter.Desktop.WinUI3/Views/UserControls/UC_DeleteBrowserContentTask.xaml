<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="eBRestarter.Desktop.WinUI3.Views.UserControls.UC_DeleteBrowserContentTask"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:eBRestarter.Desktop.WinUI3.Views.UserControls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="using:eBRestarter.Desktop.WinUI3.Converters"
             xmlns:VM="using:eBRestarter.Desktop.WinUI3.ViewModels"
             d:DataContext  ="{d:DesignInstance Type=VM:ViewModelRestartTask}"
             mc:Ignorable="d">

    <UserControl.Resources>

        <converters:BoolToImageConverter x:Key="BoolToImageConverter"
                                         ImagePathWhenFalse="ms-appx:///Resources/Visuals/Icons/Intersection/deactivate.png"
                                         ImagePathWhenTrue="ms-appx:///Resources/Visuals/Icons/Intersection/plus.png" />

    </UserControl.Resources>

    <Border x:Name          ="Border_Browser_Cleaning"
            Background      ="{ThemeResource DashletBackgroundColor_3}"
            Margin          ="0,0,0,0"
            Height          ="130"
            Width           ="405"                    
            Canvas.Left     ="612"
            Canvas.Top      ="18"
            BorderThickness ="1"                    
            CornerRadius    ="5">
        
        <Canvas>

            <Image x:Name                           ="image_browser_cleaning"
                   Source                           ="{ThemeResource CleaningBrushIcon}"
                   Height                           ="30"
                   Canvas.Left                      ="7"
                   Canvas.Top                       ="5"
                   Width                            ="30"
                   HorizontalAlignment              ="Center"
                   VerticalAlignment                ="Top"/>

            <TextBlock x:Name                       ="tbl_BrowserCleaning"
                       x:Uid                        ="BrowserCleanup"
                       Foreground                   ="{ThemeResource FontColor_1}"
                       Canvas.Left                  ="46"
                       Canvas.Top                   ="10"
                       FontSize                     ="16"
                       HorizontalAlignment          ="Center"
                       VerticalAlignment            ="Top"/>

            <Image x:Name                          ="image_restarter_agent_Copy"
                   Height                          ="25"
                   Width                           ="25"
                   Source                          ="{Binding DeleteBrowserContentIsActive, Converter={StaticResource BoolToImageConverter}}" 
                   VerticalAlignment               ="Top"
                   Canvas.Left                     ="370"
                   HorizontalAlignment             ="Left"
                   Canvas.Top                      ="8"/>

            <TextBlock x:Name                       ="tbl_DateOfNextCleaning"
                       Foreground                   ="{ThemeResource FontColor_1}"
                       Canvas.Left                  ="10"
                       Text                         ="{Binding NextDeletionProcessMessage, Mode=OneWay,UpdateSourceTrigger=PropertyChanged}"
                       Canvas.Top                   ="49"
                       FontSize                     ="16"
                       HorizontalAlignment          ="Center"
                       VerticalAlignment            ="Top"/>

            <!--Text                                ="{Binding DeleteDate}"-->
            <TextBlock x:Name                       ="tbl_txtCleaningInfo"
                       Foreground                   ="{ThemeResource FontColor_1}"
                       Canvas.Left                  ="10"
                       Canvas.Top                   ="87"
                       Text                         ="{Binding NextDeletionProcessDateMessage, Mode=OneWay,UpdateSourceTrigger=PropertyChanged}"
                       FontSize                     ="16"
                       HorizontalAlignment          ="Left"
                       VerticalAlignment            ="Center"/>

            <StackPanel Height                      ="22"
                        Width                       ="126"
                        Canvas.Top                  ="11"
                        Canvas.Left                 ="238"
                        HorizontalAlignment         ="Center"
                        VerticalAlignment           ="Top">

                <TextBlock x:Name                       ="tbl_BrowserCleaningStatus"
                           Foreground                   ="{ThemeResource FontColor_1}"
                           HorizontalAlignment          ="Right"
                           TextWrapping                 ="Wrap"
                           Text                         ="{Binding DeleteIsActivatedMessage, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                           Canvas.Top                   ="18"
                           FontSize                     ="16"/>

            </StackPanel>

        </Canvas>

    </Border>
    
</UserControl>
