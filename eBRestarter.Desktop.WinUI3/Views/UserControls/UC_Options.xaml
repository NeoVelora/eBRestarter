<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="eBRestarter.Desktop.WinUI3.Views.UserControls.UC_Options"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:eBRestarter.Desktop.WinUI3.Views.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:convertersNuget="using:CommunityToolkit.WinUI.Converters"
    mc:Ignorable="d">

    <UserControl.Resources>
        <convertersNuget:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <Grid x:Name="RootGrid"
          Background="{ThemeResource MenuBackgroundColor_2}"
          CornerRadius="8,0,0,0">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Top-Balken -->
            <RowDefinition Height="*" />
            <!-- Pivot + Inhalt -->
        </Grid.RowDefinitions>

        <!-- OBERER BALKEN -->
        <StackPanel Grid.Row="0"
                    Background="{ThemeResource MenuBackgroundColor_3}"
                    Orientation="Horizontal"
                    Height="35"           
                    VerticalAlignment="Center"
                    Spacing="10"
                    Padding="10,0,0,0">

            <FontIcon Glyph="&#xF2C7;"
                      Foreground="{ThemeResource FontColor_1}"
                      FontSize="26"
                      VerticalAlignment="Bottom"/>

            <TextBlock x:Name="tbl_MainWindowTitle"
                       Foreground="{ThemeResource FontColor_1}"
                       Margin="0,6,0,0"
                       Text="Optionen"
                       VerticalAlignment="Center"
                       FontSize="18"
                       FontWeight="Bold"/>
        </StackPanel>

        <!-- PIVOT -->
        <Pivot Grid.Row="1"
               x:Name="OptionsPivot"
               Margin="0,0,0,0">

            <!-- ========================================
             PIVOT 1: ALLGEMEIN
             ========================================= -->
            <PivotItem Margin="0,0,0,0">

                <PivotItem.Header>

                    <StackPanel Orientation="Horizontal"
                                Spacing="4">

                        <!-- optional: Icon -->
                        <FontIcon Glyph="&#xE713;"
                                  Width="20"
                                  Foreground="Black"/>

                        <TextBlock x:Uid="General"
                                   FontSize="14"
                                   VerticalAlignment="Center" Foreground="Black"/>
                    </StackPanel>

                </PivotItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">

                    <Grid x:Name="Grid_Options_General"
                           Margin="20,10,20,20"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Top">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />

                        </Grid.ColumnDefinitions>


                        <Border Grid.Column="0"
                                Background="#FFF5F5F5"
                                CornerRadius="6"
                                Padding="16"
                                Margin="0,0,24,0">

                            <StackPanel Orientation="Vertical">

                                <TextBlock x:Name="lbl_Options_OperatingSettings"
                                           x:Uid="Windows"
                                           Foreground="{ThemeResource FontColor_1}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,12" />

                                <Button x:Name="btnOptionsAutomaticWindowsUserLogin"
                                        x:Uid="Automatic_User_Login"
                                        Command="{Binding ConfigureAutoLogonCommand}" 
                                        FontSize="16"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,12"
                                        Height="50"
                                        Width="300"
                                        Background="#FF00CAD4"
                                        Foreground="#DDFFFFFF"
                                        BorderBrush="{x:Null}"/>

                                <TextBlock x:Uid="Start_eV_Restarter_with_Windows"
                                           Foreground="{ThemeResource FontColor_1}"
                                           Margin="10,8,0,4"/>

                                <ToggleSwitch x:Name="TS_OptionsStartWithWindows"
                                              x:Uid="TS_OptionsStartWithWindows"
                                              IsOn="{Binding StartWithWindows, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Foreground="{ThemeResource FontColor_1}"
                                              HorizontalAlignment="Left"
                                              Margin="10,0,0,12"
                                              Height="40"
                                              Width="250"
                                              FontSize="16"/>

                                <TextBlock x:Name="lbl_Computer_Restartoptionen"
                                           x:Uid="Computer_restart_options"
                                           Foreground="{ThemeResource FontColor_1}"
                                           Margin="10,0,0,8"
                                           FontSize="16"
                                           FontWeight="Bold"/>

                                <ComboBox x:Name="ComboboxComputerRestartOptions"
                                          FontSize="16"
                                          BorderBrush="{ThemeResource TextBoxBottumBorderBrushBackgroundColor}"
                                          Foreground="{ThemeResource FontColor_1}"
                                          Margin="10,0,10,12"
                                          Width="300"
                                          DisplayMemberPath="DisplayText"
                                          ItemsSource="{Binding ComputerRestartList}"
                                          SelectedItem="{Binding SelectedComputerRestartOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">

                                    <ComboBox.Resources>
                                        <!-- Normal -->
                                        <SolidColorBrush x:Key="ComboBoxBackground" Color="#DCDCDC" />
                                        <SolidColorBrush x:Key="ComboBoxForeground" Color="White" />
                                        <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="White" />

                                        <!-- Hover -->
                                        <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="Black" />
                                        <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="White" />
                                        <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="White" />

                                        <!-- Pressed -->
                                        <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="Black" />
                                        <SolidColorBrush x:Key="ComboBoxForegroundPressed" Color="White" />
                                        <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="White" />

                                    </ComboBox.Resources>

                                </ComboBox>


                                <StackPanel Margin="10,5,10,10"
                                            HorizontalAlignment="Left"
                                            Width="300"
                                            Visibility="{Binding IsRestartSliderVisible, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">

                                    <TextBlock Margin="0,5,5,0"
                                               Text="Lege die Uhrzeit fest:"
                                               x:Uid="Set_the_time"
                                               FontSize="14"
                                               Foreground="{ThemeResource FontColor_1}"
                                               HorizontalAlignment="Left" />
                                    
                                    <Slider x:Name="SliderRestartComputer"
                                            Minimum="{Binding ComputerRestartClockTimeMin, Mode=OneTime}"
                                            Maximum="{Binding ComputerRestartClockTimeMax, Mode=OneTime}"
                                            Value="{Binding ComputerRestartClockTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"                                            
                                            Foreground="#FF167DA4"                                            
                                            TickFrequency="1"
                                            TickPlacement="BottomRight"
                                            SnapsTo="StepValues"
                                            HorizontalAlignment="Stretch"/>

                                    <Grid Margin="0,-5,0,0">
                                        
                                        <Grid.ColumnDefinitions>
                                            
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" 
                                                   Text="{Binding ComputerRestartClockTimeMin, Mode=OneTime}" 
                                                   Foreground="Gray" 
                                                   FontSize="12"/>

                                        <TextBlock Grid.Column="2" 
                                                   Text="{Binding ComputerRestartClockTimeMax, Mode=OneTime}" 
                                                   Foreground="Gray" 
                                                   FontSize="12"/>
                                    </Grid>

                                </StackPanel>

                                <TextBlock x:Name="lbl_Options_DateOfRestartComputerInfo"
                                           Foreground="{ThemeResource FontColor_1}"
                                           Margin="10,0,0,4"
                                           Text="{Binding RestartStatusText, Mode=OneWay}"
                                           FontSize="16"/>


                                <TextBlock x:Name="tbl_restart_information"
                                           Foreground="#de1043"
                                           Margin="10,0,0,0"
                                           Text=""
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Height="51"
                                           Width="336"/>
                            </StackPanel>

                        </Border>

                        <Border Grid.Column="1"
                                Background="#FFEFEFEF"
                                CornerRadius="6"
                                Padding="16"
                                Margin="0,0,24,0">

                            <Border.Resources>
                                <!-- Einheitliche Optik nur fürs Layout (keine Farben hier) -->
                                <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="18"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="{ThemeResource FontColor_1}"/>
                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                </Style>

                            </Border.Resources>

                            <StackPanel Spacing="14">

                                <!-- UPDATE -->
                                <StackPanel Spacing="8">

                                    <TextBlock x:Uid="Update"
                                               Style="{StaticResource SectionTitleStyle}"/>

                                    <Button x:Name="BtnCheckForUpdates"
                                            x:Uid="Check_for_updates"
                                            VerticalAlignment="Stretch"
                                            HorizontalAlignment="Stretch"
                                            Background="#FF4DC89E"
                                            Foreground="#DDFFFFFF"
                                            BorderBrush="{x:Null}"/>

                                </StackPanel>

                                <!-- Trennlinie -->
                                <Border Height="1"
                                        Background="#33000000" />

                                <!-- SPEICHERORT -->
                                <StackPanel Spacing="8">

                                    <TextBlock x:Uid="Configuration_storage_location"
                                               Style="{StaticResource SectionTitleStyle}" />

                                    <Button x:Name="Btn_go_to_settings_data"
                                            x:Uid="Go_to_storage_location"
                                            VerticalAlignment="Stretch"
                                            HorizontalAlignment="Stretch"
                                            Background="#FF149DAE"
                                            Foreground="#DDFFFFFF"
                                            BorderBrush="{x:Null}"/>

                                </StackPanel>

                                <!-- Trennlinie -->
                                <Border Height="1" Background="#33000000" />

                                <!-- THEMES -->
                                <StackPanel Spacing="8">

                                    <TextBlock x:Uid="Themes"
                                               Style="{StaticResource SectionTitleStyle}" />

                                    <Button x:Name="BtnSetStandardTheme"
                                            x:Uid="Standard"
                                            VerticalAlignment="Stretch"
                                            HorizontalAlignment="Stretch"
                                            Background="#FFD5D5D5"
                                            Foreground="Black"
                                            BorderBrush="{x:Null}"/>

                                    <Button x:Name="BtnSetDarkTheme"
                                            x:Uid="Dark"
                                            Margin="0"
                                            VerticalAlignment="Stretch"
                                            HorizontalAlignment="Stretch"
                                            Background="#FF414D4F"
                                            Foreground="White"
                                            BorderBrush="{x:Null}"/>

                                </StackPanel>

                                <!-- Trennlinie -->
                                <Border Height="1"
                                        Background="#33000000" />

                                <!-- RESTARTOPTIONEN -->
                                <StackPanel Spacing="8">

                                    <TextBlock x:Uid="Language"
                                               Foreground="{ThemeResource FontColor_1}"
                                               FontSize="16"
                                               FontWeight="Bold" />

                                    <ComboBox FontSize="16"
                                              BorderBrush="{ThemeResource TextBoxBottumBorderBrushBackgroundColor}"
                                              Foreground="{ThemeResource FontColor_1}"
                                              Margin="0,0,10,12"
                                              Width="300"
                                              DisplayMemberPath="DisplayText"
                                              ItemsSource="{Binding LanguageList}"
                                              SelectedItem="{Binding SelectedLanguageOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">

                                        <ComboBox.Resources>
                                            <!-- Normal -->
                                            <SolidColorBrush x:Key="ComboBoxBackground" Color="#DCDCDC" />
                                            <SolidColorBrush x:Key="ComboBoxForeground" Color="White" />
                                            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="White" />

                                            <!-- Hover -->
                                            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="Black" />
                                            <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="White" />
                                            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="White" />

                                            <!-- Pressed -->
                                            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="Black" />
                                            <SolidColorBrush x:Key="ComboBoxForegroundPressed" Color="White" />
                                            <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="White" />

                                        </ComboBox.Resources>

                                        <ComboBoxItem Content="Deutsch" />
                                        <ComboBoxItem Content="Englisch" />

                                    </ComboBox>

                                </StackPanel>

                            </StackPanel>

                        </Border>

                    </Grid>

                </ScrollViewer>

            </PivotItem>

            <!-- ========================================
             PIVOT 2: API ZUGANG
            ========================================= -->
            <PivotItem Margin="10,0,60,0">

                <PivotItem.Header>

                    <StackPanel Orientation="Horizontal"
                                Spacing="4">

                        <FontIcon Glyph="&#xE8B8;"
                                  Width="20"
                                  Foreground="Black"/>

                        <TextBlock x:Uid="API_access"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Foreground="Black"/>

                    </StackPanel>

                </PivotItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">

                    <Grid x:Name="Grid_API_Access"
                          Margin="20,10,20,20"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Top">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="360" />
                            <ColumnDefinition Width="385" />

                        </Grid.ColumnDefinitions>


                        <Border Grid.Column="0"
                                Background="#FFF5F5F5"
                                CornerRadius="6"
                                Padding="16"
                                Margin="0,0,24,0">

                            <StackPanel Orientation="Vertical">

                                <!-- Header -->
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,12">

                                    <Image Margin="0,0,0,0"
                                           Source="\Resources\Visuals\Icons\Intersection\file_information.png"
                                           Height="35"
                                           Width="35"/>

                                    <TextBlock x:Name="lbl_options_api_informations"
                                               x:Uid="API_Information"
                                               Foreground="{ThemeResource FontColor_1}"
                                               Margin="10,4,0,0"
                                               FontSize="16" />
                                </StackPanel>

                                <!-- „Karte“ mit Username / Key -->
                                <Border x:Name="sp_Options_API_Information"
                                        Background="{ThemeResource DashletBackgroundColor_2}"
                                        CornerRadius="6"
                                        Padding="12"
                                        Margin="0,0,0,0">

                                    <StackPanel Orientation="Vertical">

                                        <TextBlock x:Name="lbl_APIUsername"
                                                   x:Uid="Username"
                                                    Foreground="{ThemeResource FontColor_1}"
                                                    HorizontalAlignment="Left"
                                                    Margin="0,0,0,8"
                                                    FontSize="16" />

                                        <StackPanel Orientation="Horizontal"
                                                    Height="52">

                                            <TextBlock x:Name="lbl_options_key"
                                                       x:Uid="API_key"
                                                       Foreground="{ThemeResource FontColor_1}"
                                                       Margin="0,10,0,10"
                                                       FontSize="16"
                                                       Width="94" />

                                            <Button x:Name="BtnShowAPIKey"
                                                    x:Uid="Show"
                                                    Content="Anzeigen"
                                                    Margin="8,5,0,10"
                                                    Width="175"
                                                    FontSize="14"
                                                    Height="35"
                                                    Background="#FF1598C9"
                                                    Foreground="#DDFFFFFF"
                                                    BorderBrush="{x:Null}"/>

                                        </StackPanel>

                                    </StackPanel>

                                </Border>

                            </StackPanel>

                        </Border>


                        <Border Grid.Column="1"
                                Background="#FFEFEFEF"
                                CornerRadius="6"
                                Padding="16">

                            <StackPanel Orientation="Vertical">

                                <!-- Header -->
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,12">

                                    <Image Margin="0,0,0,0"
                                           Source="\Resources\Visuals\Icons\Intersection\api.png"
                                           Height="40"
                                           Width="40"/>

                                    <TextBlock x:Name="lbl_options_ebesucher_api_options"
                                               x:Uid="eVisitor_API_Options"
                                               Foreground="{ThemeResource FontColor_1}"
                                               Margin="10,8,0,0"
                                               FontSize="16" />
                                </StackPanel>

                                <!-- Karte: Verbindung herstellen -->
                                <Border x:Name="sp_Options_API_1"
                                        Background="{ThemeResource DashletBackgroundColor_2}"
                                        CornerRadius="6"
                                        Padding="10"
                                        Margin="0,0,0,10">

                                    <StackPanel Orientation="Vertical">

                                        <Button x:Name="BtnConnectWithAPIInterface"
                                                x:Uid="Connect_to_API_interface"
                                                Command="{Binding ShowActivateApiDialogCommand}"
                                                Margin="0,0,0,8"
                                                Width="330"
                                                Height="40"
                                                FontSize="16"
                                                Background="#FF1598C9"
                                                Foreground="White"
                                                BorderBrush="{x:Null}"/>

                                        <Button x:Name="BtnImportAPIFile"
                                                x:Uid="Establish_API_connection_with_file_import"
                                                Margin="0,0,0,0"
                                                Width="330"
                                                Height="40"
                                                FontSize="16"
                                                Background="#FF1598C9"
                                                Foreground="White"
                                                BorderBrush="{x:Null}"/>

                                    </StackPanel>

                                </Border>

                                <!-- Karte: Export / Entfernen -->
                                <Border x:Name="sp_Options_API_2"
                                        Background="{ThemeResource DashletBackgroundColor_2}"
                                        CornerRadius="6"
                                        Padding="10">

                                    <StackPanel Orientation="Vertical">

                                        <Button x:Name="BtnGoToSavedAPIFile"
                                                x:Uid="Export_API_access_file"
                                                Margin="0,0,0,8"
                                                Width="330"
                                                FontSize="16"
                                                Height="40"
                                                IsEnabled="{Binding BtnAPISectionIsEnabled}"
                                                Background="#FF1598C9"
                                                Foreground="White"
                                                BorderBrush="{x:Null}"/>

                                        <Button x:Name="BtnRemoveAPIFile"
                                                x:Uid="Deactivate_API_interface"
                                                Margin="0,0,0,0"
                                                Width="330"
                                                FontSize="16"
                                                Height="40"
                                                IsEnabled="{Binding BtnAPISectionIsEnabled}"
                                                Background="#FF1598C9"
                                                Foreground="White"
                                                BorderBrush="{x:Null}"/>

                                    </StackPanel>

                                </Border>

                            </StackPanel>

                        </Border>

                    </Grid>

                </ScrollViewer>

            </PivotItem>

        </Pivot>

    </Grid>
    
</UserControl>
