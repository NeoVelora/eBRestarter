    <!-- Style für deinen "Browserinhalte löschen" Button -->
    <Style x:Key="ButtonCustomStyle_1"
           TargetType="Button"
           BasedOn="{StaticResource DefaultButtonStyle}">
        
        <!-- Normalzustand -->
        <Setter Property="Background"
                Value="{ThemeResource AppGrayButtonBackgroundBrush}" />
        
        <Setter Property="Foreground"
                Value="{ThemeResource AppGrayButtonForegroundBrush}" />

        <!-- Typisches Layout für diese Button-Art -->
        <Setter Property="Width" Value="295" />
        <Setter Property="Height" Value="50" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Top" />
        
    </Style>

    <!-- Style für deinen "Browserinhalte löschen" Button -->
    <Style x:Key="ButtonChooseBrowser"
           TargetType="Button"
           BasedOn="{StaticResource DefaultButtonStyle}">

        <!-- Normalzustand -->
