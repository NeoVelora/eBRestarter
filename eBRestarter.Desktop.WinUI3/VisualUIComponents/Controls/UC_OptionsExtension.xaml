<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="eBRestarter.Desktop.WinUI3.VisualUIComponents.Controls.UC_OptionsExtension"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:VM="using:eBRestarter.Desktop.WinUI3.UIStateComponents.ViewModels.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=VM:ViewModelOptionsExtension}"
    mc:Ignorable="d">

    <ScrollViewer
        HorizontalScrollBarVisibility="Auto"
        VerticalScrollBarVisibility="Auto">

        <Grid
            Margin="20,10,20,20"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            ColumnDefinitions="Auto,Auto"
            RowDefinitions="Auto,Auto">

            <!--  Header Card: Warum Erweiterung benötigt  -->
            <Border
                Grid.Row="0"
                Grid.ColumnSpan="2"
                Width="824"
                Margin="0,0,0,20"
                Padding="16"
                HorizontalAlignment="Left"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">

                <StackPanel Orientation="Horizontal" Spacing="16">

                    <!--  Info-Symbol (InfoSolid)  -->
                    <FontIcon
                        Margin="0,2,0,0"
                        VerticalAlignment="Top"
                        FontSize="28"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Glyph="&#xE946;" />

                    <StackPanel>

                        <TextBlock
                            x:Uid="BrowserExtension_WhyNeededTitle"
                            Margin="0,0,0,6"
                            d:Text="Warum wird diese Erweiterung benötigt?"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                        <TextBlock
                            x:Uid="BrowserExtension_WhyNeededDesc"
                            Width="740"
                            d:Text="Der Tab Restarter überwacht Chrome im Hintergrund. Sollte eine Webseite einfrieren, nicht mehr laden oder ein eingestelltes Zeitlimit ablaufen, leitet die Erweiterung automatisch auf die definierte Ziel-URL um."
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            LineHeight="20"
                            TextWrapping="Wrap" />

                    </StackPanel>

                </StackPanel>

            </Border>

            <!--  Links: Installations-Anleitung  -->
            <Border
                Grid.Row="1"
                Grid.Column="0"
                Width="400"
                Margin="0,0,24,0"
                Padding="16"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">

                <StackPanel Orientation="Vertical">

                    <TextBlock
                        x:Uid="BrowserExtension_InstallTitle"
                        Margin="0,0,0,12"
                        d:Text="Installation in Google Chrome"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                    <TextBlock
                        x:Uid="BrowserExtension_InstallDesc"
                        Margin="0,0,0,15"
                        d:Text="Damit der Tab Restarter funktioniert, muss die Erweiterung in Chrome geladen werden."
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        TextWrapping="Wrap" />

                    <StackPanel Margin="0,0,0,20" Spacing="8">

                        <TextBlock
                            x:Uid="BrowserExtension_Step1"
                            d:Text="1. Öffne in Chrome die Adresse:"
                            FontWeight="Bold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                        <TextBox IsReadOnly="True" Text="chrome://extensions/" />

                        <TextBlock
                            x:Uid="BrowserExtension_Step2"
                            Margin="0,5,0,0"
                            d:Text="2. Aktiviere oben rechts den Entwicklermodus."
                            FontWeight="Bold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                        <TextBlock
                            x:Uid="BrowserExtension_Step3"
                            Margin="0,5,0,0"
                            d:Text="3. Klicke auf 'Entpackte Erweiterung laden'."
                            FontWeight="Bold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                        <TextBlock
                            x:Uid="BrowserExtension_Step4"
                            Margin="0,5,0,0"
                            d:Text="4. Wähle den folgenden Ordner aus:"
                            FontWeight="Bold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                    </StackPanel>

                    <Button
                        x:Uid="BrowserExtension_BtnOpenFolder"
                        Height="40"
                        Margin="0,18,0,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom"
                        d:Content="Erweiterungs-Ordner öffnen"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.OpenExtensionFolderCommand}" />

                </StackPanel>

            </Border>

            <!--  Rechts: Konfiguration  -->
            <Border
                Grid.Row="1"
                Grid.Column="1"
                Width="400"
                Padding="16"
                VerticalAlignment="Top"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">

                <StackPanel Spacing="14">

                    <TextBlock
                        x:Uid="BrowserExtension_ConfigTitle"
                        Margin="0,0,0,6"
                        d:Text="Konfiguration (config.json)"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                    <StackPanel>

                        <TextBlock
                            x:Uid="BrowserExtension_TargetUrl"
                            Margin="0,0,0,4"
                            d:Text="Ziel-URL (inkl. https://)"
                            FontWeight="Bold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                        <TextBox
                            x:Uid="BrowserExtension_TargetUrlBox"
                            d:PlaceholderText="https://www.beispiel.de"
                            Text="{x:Bind ViewModel.ExtensionUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    </StackPanel>

                    <StackPanel>

                        <TextBlock
                            x:Uid="BrowserExtension_WaitTime"
                            Margin="0,0,0,4"
                            d:Text="Wartezeit bis zur Umleitung (Minuten)"
                            FontWeight="Bold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                        <NumberBox
                            Minimum="1"
                            SpinButtonPlacementMode="Compact"
                            Value="{x:Bind ViewModel.ExtensionWaitTimeMinutes, Mode=TwoWay}" />

                    </StackPanel>

                    <StackPanel>

                        <TextBlock
                            x:Uid="BrowserExtension_Language"
                            Margin="0,0,0,4"
                            d:Text="Sprache des Erweiterungs-Menüs"
                            FontWeight="Bold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                        <ComboBox
                            HorizontalAlignment="Stretch"
                            DisplayMemberPath="DisplayText"
                            ItemsSource="{x:Bind ViewModel.ExtensionLanguages, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedExtensionLanguage, Mode=TwoWay}" />

                    </StackPanel>

                    <Border
                        Height="1"
                        Margin="0,10,0,5"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Button
                        x:Uid="BrowserExtension_BtnSave"
                        Height="40"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom"
                        d:Content="Konfiguration speichern"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.SaveExtensionConfigCommand}" />

                    <TextBlock
                        Height="20"
                        HorizontalAlignment="Center"
                        FontWeight="Bold"
                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                        Text="{x:Bind ViewModel.ExtensionSaveStatus, Mode=OneWay}" />

                </StackPanel>

            </Border>

        </Grid>

    </ScrollViewer>

</UserControl>
