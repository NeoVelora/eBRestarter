<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="eBRestarter.Desktop.WinUI3.VisualUIComponents.Controls.UC_OptionsApi"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:VM="using:eBRestarter.Desktop.WinUI3.UIStateComponents.ViewModels.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=VM:ViewModelOptionsApi}"
    mc:Ignorable="d">

    <ScrollViewer
        HorizontalScrollBarVisibility="Auto"
        VerticalScrollBarVisibility="Auto">

        <Grid
            Margin="20,10,20,20"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            ColumnDefinitions="360,385">

            <Border
                Grid.Column="0"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">

                <StackPanel Orientation="Vertical" Spacing="12">

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="10">

                        <Image
                            Width="40"
                            Height="40"
                            Source="ms-appx:///Resources/Visuals/Icons/Intersection/api.png" />

                        <TextBlock
                            x:Uid="eVisitor_API_Options"
                            VerticalAlignment="Center"
                            d:Text="eBesucher API Optionen"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                    </StackPanel>

                    <Border
                        Padding="10"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">

                        <StackPanel Orientation="Vertical" Spacing="8">

                            <Button
                                x:Uid="Connect_to_API_interface"
                                Width="330"
                                Height="40"
                                d:Content="Mit API Schnittstelle verbinden"
                                FontSize="16"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.ShowActivateApiDialogCommand}" />

                            <Button
                                x:Uid="Deactivate_API_interface"
                                Width="330"
                                Height="40"
                                d:Content="API Schnittstelle deaktivieren"
                                FontSize="16"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.RemoveApiCredentialsCommand}" />

                        </StackPanel>

                    </Border>

                </StackPanel>

            </Border>

        </Grid>

    </ScrollViewer>

</UserControl>
