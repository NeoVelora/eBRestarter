<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="eBRestarter.Desktop.WinUI3.VisualUIComponents.Controls.UC_eVisitorUsername"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:VM="using:eBRestarter.Desktop.WinUI3.UIStateComponents.ViewModels.Pages"
    xmlns:behaviors="using:CommunityToolkit.WinUI.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=VM:ViewModelRestarterProperties}"
    mc:Ignorable="d">

    <Border
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">

        <Grid RowDefinitions="50,Auto">

            <StackPanel Grid.Row="0" Orientation="Horizontal">

                <Image
                    Width="40"
                    Height="30"
                    Margin="15,5,0,0"
                    Source="{ThemeResource UserIcon}" />

                <TextBlock
                    x:Uid="eVisitorUsername"
                    Height="27"
                    Margin="10,5,0,0"
                    d:Text="eBesucher Nutzername"
                    FontSize="17"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    TextWrapping="Wrap" />

            </StackPanel>

            <StackPanel Grid.Row="1">

                <Button
                    x:Uid="RegisterWitheVisitor"
                    Width="280"
                    Height="35"
                    Margin="20,5,0,0"
                    HorizontalAlignment="Left"
                    d:Content="Bei eBesucher registrieren"
                    FontSize="16"
                    Command="{x:Bind ViewModelRestarterProperties.RegisterToEVisitorCommand}" />

                <TextBlock
                    x:Uid="Please_Enter_Your_Username_Here"
                    Margin="20,10,0,0"
                    HorizontalAlignment="Left"
                    d:Text="Bitte gebe hier deinen Nutzernamen ein:"
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                <TextBox
                    Width="280"
                    Height="35"
                    Margin="20,8,0,0"
                    HorizontalAlignment="Left"
                    AcceptsReturn="False"
                    FontSize="18"
                    Text="{x:Bind ViewModelRestarterProperties.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">

                    <interactivity:Interaction.Behaviors>
                        <behaviors:KeyDownTriggerBehavior Key="Enter">
                            <interactivity:InvokeCommandAction Command="{x:Bind ViewModelRestarterProperties.AddEVisitorUsernameCommand}" />
                        </behaviors:KeyDownTriggerBehavior>
                    </interactivity:Interaction.Behaviors>

                </TextBox>

                <Button
                    x:Uid="Add"
                    Width="280"
                    Height="35"
                    Margin="20,10,0,0"
                    HorizontalAlignment="Left"
                    BorderBrush="Transparent"
                    d:Content="Hinzufügen"
                    FontSize="16"
                    Style="{StaticResource ButtonCustomStyle_1}"
                    Command="{x:Bind ViewModelRestarterProperties.AddEVisitorUsernameCommand}" />

            </StackPanel>

        </Grid>

    </Border>

</UserControl>
