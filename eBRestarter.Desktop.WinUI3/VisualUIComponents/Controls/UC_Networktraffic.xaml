<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="eBRestarter.Desktop.WinUI3.VisualUIComponents.Controls.UC_Networktraffic"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:eBRestarter.Desktop.WinUI3.ObjectArchetypes.Models.DisplayModels"
    mc:Ignorable="d">

    <Border
        Padding="0"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">

        <StackPanel>

            <StackPanel
                Height="46"
                Orientation="Horizontal"
                Spacing="8">

                <Image
                    Width="32"
                    Height="32"
                    Margin="8,0,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Source="ms-appx:///Resources/Visuals/Icons/Intersection/globe-grid.png" />

                <TextBlock
                    x:Uid="NetworkTraffic"
                    VerticalAlignment="Center"
                    d:Text="Netzwerktraffic"
                    FontSize="20"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

            </StackPanel>

            <Grid
                Width="280"
                Height="180"
                HorizontalAlignment="Center">

                <ScrollViewer
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">

                    <ItemsControl ItemsSource="{x:Bind ViewModelNetworkTraffic.NetworkCards, Mode=OneWay}">

                        <ItemsControl.ItemTemplate>

                            <DataTemplate x:DataType="models:NetworkCardDisplayModel">

                                <Grid
                                    Margin="0,0,0,12"
                                    ColumnDefinitions="Auto,*"
                                    ColumnSpacing="8"
                                    RowDefinitions="Auto,Auto,Auto"
                                    RowSpacing="4">

                                    <Image
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Width="23"
                                        Height="23"
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        Source="{ThemeResource NetworkCardIcon}" />

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="15"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        Text="{x:Bind AdapterName, Mode=OneWay}" />

                                    <Image
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Width="23"
                                        Height="23"
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        Source="{ThemeResource DownloadIcon}" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="15"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        Text="{x:Bind ReceivedData, Mode=OneWay}" />

                                    <Image
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Width="23"
                                        Height="23"
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        Source="{ThemeResource SendDataIcon}" />

                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="15"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        Text="{x:Bind SentData, Mode=OneWay}" />

                                </Grid>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </ScrollViewer>

            </Grid>

        </StackPanel>

    </Border>

</UserControl>