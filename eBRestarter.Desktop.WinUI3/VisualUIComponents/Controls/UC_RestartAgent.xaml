<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="eBRestarter.Desktop.WinUI3.VisualUIComponents.Controls.UC_RestartAgent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:VM="using:eBRestarter.Desktop.WinUI3.UIStateComponents.ViewModels.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:usercontrol="using:eBRestarter.Desktop.WinUI3.VisualUIComponents.Controls"
    d:DataContext="{d:DesignInstance Type=VM:ViewModelRestartTask}"
    mc:Ignorable="d">

    <StackPanel
        HorizontalAlignment="Stretch"
        Padding="5"
        Background="Transparent"
        Orientation="Horizontal"
        Spacing="10">

        <usercontrol:UC_RestartTask />

        <usercontrol:UC_DeleteBrowserContentTask />

    </StackPanel>

</UserControl>
