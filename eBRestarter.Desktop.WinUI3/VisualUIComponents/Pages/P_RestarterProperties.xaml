<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="eBRestarter.Desktop.WinUI3.VisualUIComponents.Pages.P_RestarterProperties"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:userControls="using:eBRestarter.Desktop.WinUI3.VisualUIComponents.Controls"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Page.Resources>
        <x:Double x:Key="RestarterCardWidth">320</x:Double>
        <x:Double x:Key="RestarterCardHeight">220</x:Double>
    </Page.Resources>

    <Grid
        CornerRadius="8,0,0,0"
        Background="Transparent">

        <!--  2 Zeilen: oben Titel, unten Inhalt  -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  OBERER BALKEN  -->
        <StackPanel
            Grid.Row="0"
            Height="35"
            Margin="5,5,5,0"
            Padding="10,0,0,0"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="10"
            CornerRadius="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

            <!--  Eigenschaften-Symbol (PageProperties / Equalizer)  -->
            <FontIcon
                VerticalAlignment="Center"
                FontFamily="Segoe MDL2 Assets"
                FontSize="28"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                Glyph="&#xECA5;" />

            <TextBlock
                x:Uid="Properties"
                Margin="0,-3,0,0"
                VerticalAlignment="Center"
                FontSize="18"
                FontWeight="Bold"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

        </StackPanel>

        <!--  INHALT  -->
        <Grid Grid.Row="1">
            <!--  links: flexibel, rechts: so breit wie nötig und immer am rechten Rand  -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  LINKE SPALTE: GridView mit Wrap  -->
            <GridView
                Grid.Column="0"
                HorizontalAlignment="Left"
                IsItemClickEnabled="False"
                SelectionMode="None">

                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:ItemsWrapGrid Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>

                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                        <Setter Property="Padding" Value="5,0,0,0" />
                        <Setter Property="Margin" Value="0,20,0,0" />
                    </Style>
                </GridView.ItemContainerStyle>

                <userControls:UC_eVisitorUsername Width="{StaticResource RestarterCardWidth}" Height="{StaticResource RestarterCardHeight}" />

                <userControls:UC_RestartAndRuntimeOptions Width="{StaticResource RestarterCardWidth}" Height="{StaticResource RestarterCardHeight}" />

                <userControls:UC_AutomatedTasks Width="{StaticResource RestarterCardWidth}" Height="{StaticResource RestarterCardHeight}" />

                <userControls:UC_AdditionalOptions Width="{StaticResource RestarterCardWidth}" Height="{StaticResource RestarterCardHeight}" />
            </GridView>

            <!--  RECHTE SPALTE: InstalledBrowsers rechtsbündig  -->
            <ScrollViewer
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">

                <userControls:UC_InstalledBrowsers
                    Width="270"
                    Height="Auto"
                    Margin="0,20,10,10" />

            </ScrollViewer>

        </Grid>

    </Grid>

</Page>
