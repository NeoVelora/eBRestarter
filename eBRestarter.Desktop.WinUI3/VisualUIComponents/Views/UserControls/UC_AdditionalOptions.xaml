<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="eBRestarter.Desktop.WinUI3.VisualUIComponents.Views.UserControls.UC_AdditionalOptions"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:VM="using:eBRestarter.Desktop.WinUI3.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=VM:ViewModelRestarterProperties}"
    mc:Ignorable="d">

    <Border
        Padding="10"
        Background="{ThemeResource DashletBackgroundColor_1}"
        BorderThickness="1"
        CornerRadius="5">

        <Grid>

            <Grid.RowDefinitions>
                <!--  Header: Icon + Titel  -->
                <RowDefinition Height="Auto" />
                <!--  Hinweis-Text  -->
                <RowDefinition Height="Auto" />
                <!--  Button 1  -->
                <RowDefinition Height="Auto" />
                <!--  Button 2  -->
                <RowDefinition Height="Auto" />
                <!--  Button 3  -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel
                Grid.Row="0"
                Margin="0,0,0,8"
                Orientation="Horizontal">

                <Image
                    Width="28"
                    Height="28"
                    Margin="0,0,8,0"
                    Source="{ThemeResource CirclePlusIcon}" />

                <TextBlock
                    x:Uid="AdditionalOptions"
                    VerticalAlignment="Center"
                    FontSize="17"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource FontColor_1}"
                    TextWrapping="Wrap" />

            </StackPanel>

            <TextBlock
                x:Uid="No_Browsers_Installed"
                Grid.Row="1"
                Margin="0,0,0,8"
                FontSize="16"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModelRestarterProperties.NoBrowserInstalledSectionVisibility, Mode=OneWay}" />

            <Button
                x:Uid="Delete_browser_content"
                Grid.Row="2"
                Height="40"
                Margin="0,4,0,0"
                HorizontalAlignment="Stretch"
                FontSize="16"
                Command="{x:Bind ViewModelRestarterProperties.ShowBrowserDeleteContentCommand}"
                IsEnabled="{x:Bind ViewModelRestarterProperties.DeleteBrowserContentCommandIsEnabled, Mode=OneWay}" />

            <Button
                x:Uid="Install_eVisitor_add_on"
                Grid.Row="3"
                Height="40"
                Margin="0,8,0,0"
                HorizontalAlignment="Stretch"
                FontSize="16"
                Command="{x:Bind ViewModelRestarterProperties.ShowInstallAddOnDialogCommand}"
                IsEnabled="{x:Bind ViewModelRestarterProperties.InstallEVisitorAddOnCommandIsEnabled, Mode=OneWay}" />

            <Button
                x:Uid="Important_information_about_the_add_on"
                Grid.Row="4"
                Height="30"
                Margin="0,8,0,0"
                HorizontalAlignment="Stretch"
                FontSize="12"
                Command="{x:Bind ViewModelRestarterProperties.ShowInstallAddOnInfoDialogCommand}"
                IsEnabled="{x:Bind ViewModelRestarterProperties.InstallEVisitorAddOnCommandIsEnabled, Mode=OneWay}" />

        </Grid>

    </Border>

</UserControl>
