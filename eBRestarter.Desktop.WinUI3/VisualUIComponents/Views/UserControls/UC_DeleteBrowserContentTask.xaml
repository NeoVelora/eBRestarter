<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="eBRestarter.Desktop.WinUI3.VisualUIComponents.Views.UserControls.UC_DeleteBrowserContentTask"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:VM="using:eBRestarter.Desktop.WinUI3.ViewModels"
    xmlns:converters="using:eBRestarter.Desktop.WinUI3.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=VM:ViewModelRestartTask}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BoolToImageConverter
            x:Key="BoolToImageConverter"
            ImagePathWhenFalse="ms-appx:///Resources/Visuals/Icons/Intersection/deactivate.png"
            ImagePathWhenTrue="ms-appx:///Resources/Visuals/Icons/Intersection/plus.png" />
    </UserControl.Resources>

    <Border
        Canvas.Left="612"
        Canvas.Top="18"
        Width="405"
        Height="130"
        Background="{ThemeResource DashletBackgroundColor_3}"
        BorderThickness="1"
        CornerRadius="5">

        <Canvas>

            <Image
                Canvas.Left="7"
                Canvas.Top="5"
                Width="30"
                Height="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Source="{ThemeResource CleaningBrushIcon}" />

            <TextBlock
                x:Uid="BrowserCleanup"
                Canvas.Left="46"
                Canvas.Top="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                FontSize="16"
                Foreground="{ThemeResource FontColor_1}" />

            <Image
                Canvas.Left="370"
                Canvas.Top="8"
                Width="25"
                Height="25"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Source="{x:Bind ViewModelRestartTask.DeleteBrowserContentIsActive, Converter={StaticResource BoolToImageConverter}, Mode=OneWay}" />

            <TextBlock
                Canvas.Left="10"
                Canvas.Top="49"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                FontSize="16"
                Foreground="{ThemeResource FontColor_1}"
                Text="{x:Bind ViewModelRestartTask.NextDeletionProcessMessage, Mode=OneWay}" />

            <TextBlock
                Canvas.Left="10"
                Canvas.Top="87"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontSize="16"
                Foreground="{ThemeResource FontColor_1}"
                Text="{x:Bind ViewModelRestartTask.NextDeletionProcessDateMessage, Mode=OneWay}" />

            <StackPanel
                Canvas.Left="238"
                Canvas.Top="11"
                Width="126"
                Height="22"
                HorizontalAlignment="Center"
                VerticalAlignment="Top">

                <TextBlock
                    HorizontalAlignment="Right"
                    FontSize="16"
                    Foreground="{ThemeResource FontColor_1}"
                    Text="{x:Bind ViewModelRestartTask.DeleteIsActivatedMessage, Mode=OneWay}"
                    TextWrapping="Wrap" />

            </StackPanel>

        </Canvas>

    </Border>

</UserControl>
