<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="eBRestarter.Desktop.WinUI3.VisualUIComponents.Views.UserControls.UC_OptionsApi"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:VM="using:eBRestarter.Desktop.WinUI3.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=VM:ViewModelOptionsApi}"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Grid
            x:Name="Grid_API_Access"
            Margin="20,10,20,20"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="385" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Padding="16"
                Background="{ThemeResource DashletBackgroundColor_2}"
                CornerRadius="6">

                <StackPanel Orientation="Vertical">
                    <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                        <Image
                            Width="40"
                            Height="40"
                            Margin="0,0,0,0"
                            Source="\Resources\Visuals\Icons\Intersection\api.png" />

                        <TextBlock
                            x:Name="lbl_options_ebesucher_api_options"
                            x:Uid="eVisitor_API_Options"
                            Margin="10,8,0,0"
                            FontSize="16"
                            Foreground="{ThemeResource FontColor_1}" />
                    </StackPanel>

                    <Border
                        x:Name="sp_Options_API_1"
                        Margin="0,0,0,10"
                        Padding="10"
                        Background="{ThemeResource DashletBackgroundColor_5}"
                        CornerRadius="6">

                        <StackPanel Orientation="Vertical">
                            <Button
                                x:Name="BtnConnectWithAPIInterface"
                                x:Uid="Connect_to_API_interface"
                                Width="330"
                                Height="40"
                                Margin="0,0,0,8"
                                Background="#FF1598C9"
                                BorderBrush="{x:Null}"
                                Command="{x:Bind ViewModel.ShowActivateApiDialogCommand}"
                                FontSize="16"
                                Foreground="White" />

                            <Button
                                x:Name="BtnRemoveAPIFile"
                                x:Uid="Deactivate_API_interface"
                                Width="330"
                                Height="40"
                                Margin="0,0,0,0"
                                Background="#FF1598C9"
                                BorderBrush="{x:Null}"
                                Command="{x:Bind ViewModel.RemoveApiCredentialsCommand}"
                                FontSize="16"
                                Foreground="White" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
