<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="eBRestarter.Desktop.WinUI3.VisualUIComponents.Views.UserControls.UC_Options"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:eBRestarter.Desktop.WinUI3.VisualUIComponents.Views.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        Background="{ThemeResource MenuBackgroundColor_2}"
        CornerRadius="8,0,0,0">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Height="35"
            Margin="5"
            Padding="10,0,0,0"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="10"
            Background="{ThemeResource MenuBackgroundColor}"
            CornerRadius="8">

            <!--  Optionen-Symbol  -->
            <FontIcon
                Margin="0,0,0,3"
                VerticalAlignment="Bottom"
                FontSize="26"
                Foreground="{ThemeResource FontColor_1}"
                Glyph="&#xF2C7;" />

            <TextBlock
                x:Uid="Options"
                Margin="0,6,0,9"
                VerticalAlignment="Center"
                FontSize="18"
                FontWeight="Bold"
                Foreground="{ThemeResource FontColor_1}" />
        </StackPanel>

        <Pivot
            x:Name="OptionsPivot"
            Grid.Row="1">

            <PivotItem>
                <PivotItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <!--  Einstellungen-Symbol (Setting)  -->
                        <FontIcon
                            Width="20"
                            Foreground="{ThemeResource FontColor_1}"
                            Glyph="&#xE713;" />
                        <TextBlock
                            x:Uid="General"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Foreground="{ThemeResource FontColor_1}" />
                    </StackPanel>
                </PivotItem.Header>
                <local:UC_OptionsGeneral />
            </PivotItem>

            <PivotItem Margin="10,0,60,0">
                <PivotItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <!--  API-Symbol  -->
                        <FontIcon
                            Width="20"
                            Foreground="{ThemeResource FontColor_1}"
                            Glyph="&#xE8B8;" />
                        <TextBlock
                            x:Uid="API_access"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Foreground="{ThemeResource FontColor_1}" />
                    </StackPanel>
                </PivotItem.Header>
                <local:UC_OptionsApi />
            </PivotItem>

            <PivotItem>
                <PivotItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <!--  Erweiterungs-Symbol  -->
                        <FontIcon
                            Width="20"
                            Foreground="{ThemeResource FontColor_1}"
                            Glyph="&#xE774;" />
                        <TextBlock
                            x:Uid="BrowserExtension"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Foreground="{ThemeResource FontColor_1}" />
                    </StackPanel>
                </PivotItem.Header>
                <local:UC_OptionsExtension />
            </PivotItem>
        </Pivot>
    </Grid>
</UserControl>
