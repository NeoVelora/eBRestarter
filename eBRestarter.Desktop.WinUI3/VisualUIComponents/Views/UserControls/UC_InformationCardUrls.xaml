<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="eBRestarter.Desktop.WinUI3.VisualUIComponents.Views.UserControls.UC_InformationCardUrls"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:eBRestarter.Desktop.WinUI3.VisualUIComponents.Views.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Border
            x:Name="Border_browser_downloadlinks"
            Grid.Row="1"
            Width="Auto"
            Height="Auto"
            Margin="0"
            Background="{ThemeResource DashletBackgroundColor_5}"
            BorderThickness="0"
            CornerRadius="5">

            <StackPanel Width="Auto" Margin="0,5">

                <!--  Header  -->
                <StackPanel
                    Height="40"
                    Background="{ThemeResource DashletBackgroundColor_5}"
                    Orientation="Horizontal">

                    <Image
                        Width="25"
                        Height="25"
                        Margin="10,0,0,0"
                        Source="{ThemeResource GlobeIcon3}" />

                    <TextBlock
                        x:Uid="Browser_download_links"
                        Height="25"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="{ThemeResource FontColor_1}" />

                </StackPanel>

                <!--  Links  -->
                <HyperlinkButton
                    Margin="15,7,0,0"
                    Padding="0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Command="{x:Bind ViewModelInfocenter.OpenSupportWebsiteCommand}"
                    CommandParameter="https://brave.com/de/download/"
                    Content="Brave Download"
                    Foreground="{ThemeResource FontColor_1}" />

                <HyperlinkButton
                    Margin="15,7,0,0"
                    Padding="0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Command="{x:Bind ViewModelInfocenter.OpenSupportWebsiteCommand}"
                    CommandParameter="https://www.google.com/chrome/"
                    Content="Chrome Download"
                    Foreground="{ThemeResource FontColor_1}" />

                <HyperlinkButton
                    Margin="15,7,0,0"
                    Padding="0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Command="{x:Bind ViewModelInfocenter.OpenSupportWebsiteCommand}"
                    CommandParameter="https://www.microsoft.com/de-de/edge"
                    Content="Edge Download"
                    Foreground="{ThemeResource FontColor_1}" />

                <HyperlinkButton
                    Margin="15,7,0,0"
                    Padding="0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Command="{x:Bind ViewModelInfocenter.OpenSupportWebsiteCommand}"
                    CommandParameter="https://www.mozilla.org/de/firefox/new/"
                    Content="Firefox Download"
                    Foreground="{ThemeResource FontColor_1}" />

                <HyperlinkButton
                    Margin="15,7,0,0"
                    Padding="0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Command="{x:Bind ViewModelInfocenter.OpenSupportWebsiteCommand}"
                    CommandParameter="https://vivaldi.com/download/"
                    Content="Vivaldi Download"
                    Foreground="{ThemeResource FontColor_1}" />

            </StackPanel>

        </Border>

    </Grid>

</UserControl>
