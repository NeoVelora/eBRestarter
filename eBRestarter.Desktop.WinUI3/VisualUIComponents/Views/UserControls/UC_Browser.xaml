<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="eBRestarter.Desktop.WinUI3.VisualUIComponents.Views.UserControls.UC_Browser"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:VM="using:eBRestarter.Desktop.WinUI3.ViewModels"
    xmlns:converters="using:eBRestarter.Desktop.WinUI3.Converters"
    xmlns:convertersNuget="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=VM:ViewModelBrowserItem}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <convertersNuget:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <convertersNuget:BoolToVisibilityConverter
            x:Key="InverseBoolToVisibilityConverter"
            FalseValue="Visible"
            TrueValue="Collapsed" />
        <converters:StringKeyToStyleConverter x:Key="StringKeyToStyleConverter" />
    </UserControl.Resources>

    <Border
        Width="260"
        Height="85"
        Padding="0"
        Background="{ThemeResource DashletBackgroundColor_4}"
        BorderThickness="1"
        CornerRadius="5">

        <Canvas>

            <Button
                Canvas.Left="0"
                Canvas.Top="0"
                Width="80"
                Height="83"
                HorizontalAlignment="Left"
                Style="{Binding DownloadButtonStyleKey, Converter={StaticResource StringKeyToStyleConverter}}"
                Command="{Binding ToggleDownloadCommand}"
                Content="{Binding DownloadButtonContent, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                Visibility="{Binding IsDownloadButtonVisible, Converter={StaticResource BoolToVisibilityConverter}}" />

            <Button
                x:Uid="Select"
                Canvas.Left="0"
                Canvas.Top="0"
                Width="80"
                Height="83"
                FontSize="11"
                Style="{StaticResource ButtonChooseBrowser}"
                Command="{Binding ChooseBrowserCommand}"
                Visibility="{Binding IsChooseButtonVisible, Converter={StaticResource BoolToVisibilityConverter}}" />

            <Image
                Canvas.Left="85"
                Canvas.Top="5"
                Width="{Binding ImageSizeWidthBrowser}"
                Height="{Binding ImageSizeHeightBrowser}"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Source="{Binding HeaderImageBrowser}" />

            <TextBlock
                Canvas.Left="122"
                Canvas.Top="6"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontSize="16"
                Foreground="{ThemeResource FontColor_1}"
                Text="{Binding HeaderTitleBrowser}"
                TextWrapping="Wrap" />

            <TextBlock
                Canvas.Left="86"
                Canvas.Top="57"
                FontSize="14"
                Foreground="{ThemeResource FontColor_1}"
                Text="{Binding BrowserVersionText}"
                TextWrapping="Wrap" />

            <TextBlock
                Canvas.Left="230"
                Canvas.Top="1"
                FontFamily="Segoe Fluent Icons"
                FontSize="25"
                Foreground="{Binding InstallStateGlyphForeground}"
                Text="{Binding InstallStateGlyph}"
                TextWrapping="Wrap" />

            <ProgressBar
                Canvas.Left="85"
                Canvas.Top="41"
                Width="168"
                Height="14"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                Value="{Binding DownloadProgressValue, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                Visibility="{Binding IsDownloadButtonVisible, Converter={StaticResource BoolToVisibilityConverter}}" />

            <TextBlock
                Canvas.Left="86"
                Canvas.Top="57"
                FontSize="14"
                Foreground="{ThemeResource FontColor_1}"
                Text="{Binding DownloadSizeText, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                Visibility="{Binding IsDownloadSizeTextVisible, Converter={StaticResource BoolToVisibilityConverter}}" />

        </Canvas>

    </Border>

</UserControl>
