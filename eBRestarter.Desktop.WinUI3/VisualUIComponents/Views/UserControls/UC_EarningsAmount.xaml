<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="eBRestarter.Desktop.WinUI3.VisualUIComponents.Views.UserControls.UC_EarningsAmount"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        HorizontalAlignment="Stretch"
        VerticalAlignment="Top"
        Padding="0"
        Background="{ThemeResource DashletBackgroundColor_3}"
        BorderThickness="1"
        CornerRadius="5">

        <StackPanel
            Width="340"
            Height="130"
            HorizontalAlignment="Left">

            <StackPanel Orientation="Horizontal">

                <Image
                    Width="35"
                    Height="35"
                    Margin="10,10,0,0"
                    Source="{x:Bind HeaderImageEarnings, Mode=OneWay}" />

                <TextBlock
                    Height="30"
                    Margin="10,5,0,0"
                    FontSize="22"
                    FontWeight="Normal"
                    Foreground="{ThemeResource FontColor_1}"
                    Text="{x:Bind HeaderTitleEarnings, Mode=OneWay}"
                    TextWrapping="Wrap" />

            </StackPanel>

            <StackPanel Orientation="Horizontal">

                <TextBlock
                    Margin="10,20,0,0"
                    FontSize="24"
                    FontWeight="Light"
                    Foreground="{ThemeResource FontColor_1}"
                    Text="{x:Bind EarningsAmount, Mode=OneWay}" />

            </StackPanel>

        </StackPanel>

    </Border>

</UserControl>
