<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="eBRestarter.Desktop.WinUI3.VisualUIComponents.Views.UserControls.UC_EarningsAmount"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:eBRestarter.Desktop.WinUI3.VisualUIComponents.Views.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="RootControl"
    mc:Ignorable="d">

    <Border
        x:Name="border_sum_points_todday"
        Padding="0"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Top"
        Background="{ThemeResource DashletBackgroundColor_3}"
        BorderThickness="1"
        CornerRadius="5">

        <StackPanel
            Width="340"
            Height="130"
            HorizontalAlignment="Left">

            <Grid HorizontalAlignment="Left">

                <Grid.RowDefinitions>

                    <RowDefinition Height="30*" />
                    <RowDefinition Height="70*" />

                </Grid.RowDefinitions>

            </Grid>

            <StackPanel Grid.Row="0" Orientation="Horizontal">

                <Image
                    x:Name="headerImage"
                    Width="35"
                    Height="35"
                    Margin="10,10,0,0"
                    Source="{Binding ElementName=RootControl, Path=HeaderImageEarnings}" />

                <TextBlock
                    x:Name="tbl_sum_points_daily"
                    Height="30"
                    Margin="10,5,0,0"
                    FontSize="22"
                    FontWeight="Normal"
                    Foreground="{ThemeResource FontColor_1}"
                    Text="{Binding ElementName=RootControl, Path=HeaderTitleEarnings}"
                    TextWrapping="Wrap" />

            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal">

                <TextBlock
                    x:Name="tbl_EarningsDay"
                    Margin="10,20,0,0"
                    FontSize="24"
                    FontWeight="Light"
                    Foreground="{ThemeResource FontColor_1}"
                    Text="{Binding ElementName=RootControl, Path=EarningsAmount}" />

            </StackPanel>

        </StackPanel>

    </Border>

</UserControl>
