<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="eBRestarter.Desktop.WinUI3.VisualUIComponents.Views.UserControls.UC_PointsOutput"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:eBRestarter.Desktop.WinUI3.ViewModels"
    mc:Ignorable="d">

    <Grid
        Background="{ThemeResource DashletBackgroundColor_2}"
        BorderThickness="1"
        CornerRadius="8">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="12,12,12,4">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Pivot Grid.Column="1" SelectedIndex="{x:Bind ViewModelGeneralOverview.SelectedPivotIndex, Mode=TwoWay}">

                <PivotItem>
                    <PivotItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <!--  Kalender-Tag-Symbol (CalendarDay)  -->
                            <FontIcon
                                FontSize="16"
                                Foreground="{ThemeResource FontColor_1}"
                                Glyph="&#xE916;" />
                            <TextBlock
                                x:Uid="Today"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{ThemeResource FontColor_1}" />
                        </StackPanel>
                    </PivotItem.Header>
                </PivotItem>

                <PivotItem>
                    <PivotItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <!--  Kalender-Monat-Symbol (CalendarWeek)  -->
                            <FontIcon
                                FontSize="16"
                                Foreground="{ThemeResource FontColor_1}"
                                Glyph="&#xE787;" />
                            <TextBlock
                                x:Uid="Month"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{ThemeResource FontColor_1}" />
                        </StackPanel>
                    </PivotItem.Header>
                </PivotItem>

                <PivotItem>
                    <PivotItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <!--  Kalender-Jahr-Symbol (Calendar)  -->
                            <FontIcon
                                FontSize="16"
                                Foreground="{ThemeResource FontColor_1}"
                                Glyph="&#xE909;" />
                            <TextBlock
                                x:Uid="Year"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{ThemeResource FontColor_1}" />
                        </StackPanel>
                    </PivotItem.Header>
                </PivotItem>

            </Pivot>

        </Grid>

        <Border
            Grid.Row="1"
            Margin="12"
            Background="{ThemeResource ChartBorderBackground}"
            BorderThickness="1"
            CornerRadius="8">

            <lvc:CartesianChart
                MinHeight="250"
                Margin="12"
                CornerRadius="5"
                RequestedTheme="{ThemeResource GeneralRequestedTheme}"
                Series="{x:Bind ViewModelGeneralOverview.Series, Mode=OneWay}"
                TooltipPosition="Top"
                XAxes="{x:Bind ViewModelGeneralOverview.XAxes, Mode=OneWay}"
                YAxes="{x:Bind ViewModelGeneralOverview.YAxes, Mode=OneWay}" />

        </Border>

    </Grid>

</UserControl>