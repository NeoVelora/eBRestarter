<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="eBRestarter.Desktop.WinUI3.VisualUIComponents.Views.UserControls.UC_AutomatedTasks"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:VM="using:eBRestarter.Desktop.WinUI3.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=VM:ViewModelRestarterProperties}"
    mc:Ignorable="d">

    <Border
        Padding="10"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">

        <Grid RowDefinitions="Auto,Auto,Auto">

            <StackPanel
                Grid.Row="0"
                Margin="0,0,0,8"
                Orientation="Horizontal">

                <Image
                    Width="28"
                    Height="28"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Source="{ThemeResource GearIcon}" />

                <TextBlock
                    x:Uid="AutomatedTasks"
                    VerticalAlignment="Center"
                    FontSize="17"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="2">

                <ToggleSwitch
                    x:Uid="TSStartBrowserWithProgrammStart"
                    HorizontalAlignment="Stretch"
                    IsOn="{x:Bind ViewModelRestarterProperties.StartBrowserWithProgramStart, Mode=TwoWay}" />

                <ToggleSwitch
                    x:Uid="TSCheckBrowserIsAlive"
                    HorizontalAlignment="Stretch"
                    IsOn="{x:Bind ViewModelRestarterProperties.CheckBrowserIsAliveIsOn, Mode=TwoWay}" />

                <HyperlinkButton
                    Padding="0"
                    HorizontalContentAlignment="Left"
                    Command="{x:Bind ViewModelRestarterProperties.OpenStartupBoostDialogCommand}">

                    <TextBlock
                        x:Uid="StartupEdgeBoost_Info"
                        FontSize="10"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        TextWrapping="Wrap" />

                </HyperlinkButton>

            </StackPanel>

            <ComboBox
                Grid.Row="2"
                Height="40"
                Margin="0,8,0,0"
                HorizontalAlignment="Stretch"
                DisplayMemberPath="DisplayText"
                FontSize="14"
                d:PlaceholderText="Browser delete cache options"
                SelectedIndex="0"
                IsEnabled="{x:Bind ViewModelRestarterProperties.DeleteBrowserContentCommandIsEnabled, Mode=OneWay}"
                ItemsSource="{x:Bind ViewModelRestarterProperties.BrowserDeleteCacheOptionList, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModelRestarterProperties.SelectedDeleteBrowserCacheOption, Mode=TwoWay}" />

        </Grid>

    </Border>

</UserControl>