<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="eBRestarter.Desktop.WinUI3.VisualUIComponents.Views.Dialogs.AutoLogonDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Uid="AutoLogonDialog"
    DefaultButton="Primary"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <ContentDialog.Resources>

        <Style BasedOn="{StaticResource DefaultTextBoxStyle}" TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style BasedOn="{StaticResource DefaultPasswordBoxStyle}" TargetType="PasswordBox">
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

    </ContentDialog.Resources>

    <Grid MinWidth="350">

        <StackPanel Spacing="0">

            <InfoBar
                x:Uid="AutoLogon_InfoSecurity"
                Margin="0,0,0,20"
                IsClosable="False"
                IsOpen="True"
                Severity="Warning" />

            <InfoBar
                x:Name="AdminWarningInfoBar"
                x:Uid="AutoLogon_AdminWarning"
                Margin="0,0,0,16"
                IsClosable="False"
                IsOpen="False"
                Severity="Error" />

            <CheckBox
                x:Name="CbDisablePasswordless"
                x:Uid="AutoLogon_DisablePasswordless"
                Margin="0,0,0,16"
                Visibility="Collapsed" />

            <CheckBox
                x:Name="CbRestorePasswordless"
                x:Uid="AutoLogon_RestorePasswordless"
                Margin="0,0,0,16"
                Visibility="Collapsed" />

            <TextBox
                x:Name="TxtUsername"
                x:Uid="AutoLogon_InputUser" />

            <TextBox
                x:Name="TxtDomain"
                x:Uid="AutoLogon_InputDomain" />

            <!--  🔒 Security-Guideline Kap. 3.x: PasswordRevealMode="Hidden" statt "Peek".
                 Hier wird ein Windows-/Domänen-Kennwort eingegeben; die Peek-Schaltfläche machte es
                 im Klartext sichtbar und damit per Shoulder-Surfing oder Screenshare abgreifbar.  -->
            <PasswordBox
                x:Name="PbPassword"
                x:Uid="AutoLogon_InputPassword"
                PasswordRevealMode="Hidden" />
        </StackPanel>

    </Grid>

</ContentDialog>