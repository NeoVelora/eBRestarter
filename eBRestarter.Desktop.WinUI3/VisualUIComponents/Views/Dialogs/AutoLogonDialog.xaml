<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="eBRestarter.Desktop.WinUI3.VisualUIComponents.Views.Dialogs.AutoLogonDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Uid="AutoLogonDialog"
    DefaultButton="Primary"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ContentDialog.Resources>

        <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style TargetType="PasswordBox" BasedOn="{StaticResource DefaultPasswordBoxStyle}">
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

    </ContentDialog.Resources>

    <Grid MinWidth="350">

        <StackPanel Spacing="0">

            <InfoBar x:Uid="AutoLogon_InfoSecurity"
                     Severity="Warning" 
                     IsOpen="True" 
                     IsClosable="False"
                     Margin="0,0,0,20"/>

            <InfoBar x:Name="AdminWarningInfoBar"
                     Title="Administratorrechte erforderlich"
                     Message="Die kennwortlose Anmeldung (Windows Hello) ist aktiv. Um AutoLogon zu aktivieren, starten Sie die Anwendung bitte als Administrator."
                     Severity="Error" 
                     IsOpen="False" 
                     IsClosable="False"
                     Margin="0,0,0,16"/>

            <CheckBox x:Name="CbDisablePasswordless"
                      Content="Kennwortlose Anmeldung (Windows Hello) deaktivieren, um AutoLogon zu erlauben"
                      Visibility="Collapsed"
                      Margin="0,0,0,16"/>

            <CheckBox x:Name="CbRestorePasswordless"
                      Content="Kennwortlose Anmeldung (Windows Hello) wiederherstellen"
                      Visibility="Collapsed"
                      Margin="0,0,0,16"/>

            <TextBox x:Name="TxtUsername" 
                     x:Uid="AutoLogon_InputUser" />

            <TextBox x:Name="TxtDomain" 
                     x:Uid="AutoLogon_InputDomain" />

            <!-- 🔒 Security-Guideline Kap. 3.x: PasswordRevealMode="Hidden" statt "Peek".
                 Hier wird ein Windows-/Domänen-Kennwort eingegeben; die Peek-Schaltfläche machte es
                 im Klartext sichtbar und damit per Shoulder-Surfing oder Screenshare abgreifbar. -->
            <PasswordBox x:Name="PbPassword"
                         x:Uid="AutoLogon_InputPassword"
                         PasswordRevealMode="Hidden"/>
        </StackPanel>

    </Grid>

</ContentDialog>