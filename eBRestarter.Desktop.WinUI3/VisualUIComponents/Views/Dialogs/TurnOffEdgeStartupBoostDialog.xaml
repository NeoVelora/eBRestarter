<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="eBRestarter.Desktop.WinUI3.VisualUIComponents.Views.Dialogs.TurnOffEdgeStartupBoostDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Uid="StartupBoostDialog"
    DefaultButton="Close"
    RequestedTheme="Dark"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <Grid MaxWidth="500">
        <StackPanel Spacing="20">

            <StackPanel Orientation="Horizontal" Spacing="15">
                <Image
                    Width="48"
                    Height="48"
                    VerticalAlignment="Top"
                    Source="ms-appx:///Resources/Visuals/Icons/Intersection/fa_edge.png" />
                <TextBlock
                    x:Uid="StartupBoostDialog_InfoText"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="Wenn du den Startup-Boost deaktivieren willst..."
                    TextWrapping="Wrap" />
            </StackPanel>

            <MenuFlyoutSeparator />

            <StackPanel
                Padding="15"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8"
                Spacing="10">

                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">
                    <FontIcon Foreground="{ThemeResource SystemFillColorSuccessBrush}" Glyph="&#xE945;" />
                    <TextBlock
                        x:Uid="StartupBoostDialog_OptionAuto_Header"
                        FontWeight="Bold"
                        Text="1. Automatisch (Registry)" />
                </StackPanel>

                <TextBlock
                    x:Uid="StartupBoostDialog_OptionAuto_Desc"
                    Margin="0,0,0,5"
                    FontSize="12"
                    Opacity="0.7"
                    TextWrapping="Wrap" />

                <ToggleSwitch
                    x:Uid="StartupBoostDialog_SwitchStatus"
                    HorizontalAlignment="Stretch"
                    IsEnabled="{x:Bind ViewModel.IsAdministrator, Mode=OneWay}"
                    IsOn="{x:Bind ViewModel.IsStartupBoostEnabled, Mode=TwoWay}" />

                <!--  Warnhinweis, wenn nicht als Admin gestartet  -->
                <InfoBar
                    x:Uid="StartupBoostDialog_AdminWarning"
                    Margin="0,10,0,0"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.IsNotAdministrator, Mode=OneWay}"
                    Severity="Warning" />

                <InfoBar
                    Title="{x:Bind ViewModel.InfoBarTitle, Mode=OneWay}"
                    Margin="0,10,0,0"
                    IsClosable="True"
                    IsOpen="{x:Bind ViewModel.IsInfoBarOpen, Mode=TwoWay}"
                    Message="{x:Bind ViewModel.InfoBarMessage, Mode=OneWay}"
                    Severity="{x:Bind ViewModel.InfoBarSeverity, Mode=OneWay}" />

            </StackPanel>

            <StackPanel Padding="10" Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE8C8;" />
                    <TextBlock
                        x:Uid="StartupBoostDialog_OptionManual_Header"
                        FontWeight="Bold"
                        Text="2. Manuell" />
                </StackPanel>

                <TextBlock
                    x:Uid="StartupBoostDialog_OptionManual_Desc"
                    FontSize="12"
                    Opacity="0.7"
                    TextWrapping="Wrap" />

                <TextBox
                    x:Uid="StartupBoostDialog_LinkText"
                    FontFamily="Consolas"
                    IsReadOnly="True"
                    Text="edge://settings/?search=Startup-Boost" />

                <Button
                    x:Uid="StartupBoostDialog_BtnCopy"
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ViewModel.CopyAndOpenEdgeCommand}" />

            </StackPanel>

        </StackPanel>
    </Grid>
</ContentDialog>