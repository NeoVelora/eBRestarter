<ContentDialog
    x:Class="eBRestarter.Desktop.WinUI3.VisualUIComponents.Views.Dialogs.InstallAddOnDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:eBRestarter.Desktop.WinUI3.ViewModels"
    x:Uid="InstallAddOnDialog"
    DefaultButton="Close"
    RequestedTheme="Dark"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <Grid RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Uid="InstallAddOnDialog_Instruction"
            Opacity="0.8"
            Style="{ThemeResource BodyTextBlockStyle}"
            TextWrapping="Wrap" />

        <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModelInstallAddOn.Browsers, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ViewModelBrowserAddonStatus">

                    <Border
                        Margin="0,0,0,12"
                        Padding="16,12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Image
                                Width="40"
                                Height="40"
                                VerticalAlignment="Center"
                                Source="{x:Bind IconPath, Mode=OneWay}" />

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="4">

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="{x:Bind BrowserName, Mode=OneWay}" />

                                    <Border
                                        Padding="6,2"
                                        VerticalAlignment="Center"
                                        Background="{x:Bind InstallStatusColor, Mode=OneWay}"
                                        CornerRadius="4">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Foreground="White"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind InstallStatusText, Mode=OneWay}" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe UI Symbol"
                                        FontWeight="Bold"
                                        Foreground="{x:Bind AddonStatusColor, Mode=OneWay}"
                                        Text="{x:Bind AddonStatusIcon, Mode=OneWay}" />

                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Opacity="0.7"
                                        Style="{ThemeResource BodyTextBlockStyle}"
                                        Text="{x:Bind AddonStatusText, Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>

                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Command="{x:Bind OpenStoreCommand}"
                                Content="{x:Bind ButtonText, Mode=OneWay}"
                                IsEnabled="{x:Bind IsButtonEnabled, Mode=OneWay}"
                                Style="{ThemeResource AccentButtonStyle}" />
                        </Grid>
                    </Border>

                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</ContentDialog>