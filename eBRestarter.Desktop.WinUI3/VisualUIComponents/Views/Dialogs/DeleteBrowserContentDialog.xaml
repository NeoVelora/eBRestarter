<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="eBRestarter.Desktop.WinUI3.VisualUIComponents.Views.Dialogs.DeleteBrowserContentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:VM="using:eBRestarter.Desktop.WinUI3.ViewModels"
    xmlns:convertersNuget="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Uid="DeleteDialog"
    DefaultButton="Close"
    RequestedTheme="Dark"
    Style="{StaticResource DefaultContentDialogStyle}"
    d:DataContext="{d:DesignInstance Type=VM:ViewModelDeleteBrowserContent}"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <convertersNuget:BoolNegationConverter x:Key="BoolNegationConverter" />
        <convertersNuget:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <convertersNuget:BoolToVisibilityConverter
            x:Key="InverseBoolToVisibilityConverter"
            FalseValue="Visible"
            TrueValue="Collapsed" />

        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Foreground" Value="{ThemeResource SystemControlForegroundBaseHighBrush}" />
        </Style>
    </ContentDialog.Resources>

    <Grid MinWidth="500">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,25"
            Orientation="Horizontal">
            <Image
                Width="32"
                Height="32"
                VerticalAlignment="Center"
                Source="{x:Bind ViewModelDeleteBrowserContent.BrowserIconPath, Mode=OneWay}" />

            <TextBlock
                Margin="15,0,0,0"
                VerticalAlignment="Center"
                FontSize="20"
                FontWeight="Bold"
                Text="{x:Bind ViewModelDeleteBrowserContent.BrowserName, Mode=OneWay}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,25">

            <TextBlock
                x:Uid="DeleteDialog_HeaderOptions"
                Style="{StaticResource HeaderTextStyle}" />

            <CheckBox
                x:Uid="DeleteDialog_CheckCookies"
                Margin="0,0,0,10"
                IsChecked="{x:Bind ViewModelDeleteBrowserContent.IsDeleteCookiesChecked, Mode=TwoWay}"
                IsEnabled="{x:Bind ViewModelDeleteBrowserContent.IsBusy, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}" />

            <CheckBox
                x:Uid="DeleteDialog_CheckCache"
                IsChecked="{x:Bind ViewModelDeleteBrowserContent.IsDeleteInternetCacheChecked, Mode=TwoWay}"
                IsEnabled="{x:Bind ViewModelDeleteBrowserContent.IsBusy, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}" />

        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,25">

            <TextBlock
                x:Uid="DeleteDialog_HeaderProgress"
                Style="{StaticResource HeaderTextStyle}" />

            <Grid Margin="0,0,0,5">

                <ProgressBar
                    Height="10"
                    IsEnabled="{x:Bind ViewModelDeleteBrowserContent.IsBusy, Mode=OneWay}"
                    Maximum="{x:Bind ViewModelDeleteBrowserContent.ProgressMaximum, Mode=OneWay}"
                    Value="{x:Bind ViewModelDeleteBrowserContent.ProgressValue, Mode=OneWay}" />
            </Grid>

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />

                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModelDeleteBrowserContent.StatusText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap"
                    ToolTipService.ToolTip="{x:Bind ViewModelDeleteBrowserContent.StatusText, Mode=OneWay}" />

                <TextBlock
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontWeight="Bold"
                    Text="{x:Bind ViewModelDeleteBrowserContent.ProgressText, Mode=OneWay}" />
            </Grid>
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,10,0,0">

            <Button
                x:Uid="DeleteDialog_BtnStart"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource SystemFillColorSuccessBrush}"
                Command="{x:Bind ViewModelDeleteBrowserContent.StartCleaningCommand}"
                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                Visibility="{x:Bind ViewModelDeleteBrowserContent.IsBusy, Converter={StaticResource InverseBoolToVisibilityConverter}, Mode=OneWay}" />

            <Button
                x:Uid="DeleteDialog_BtnCancel"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource SystemFillColorCriticalBrush}"
                Command="{x:Bind ViewModelDeleteBrowserContent.CancelCleaningCommand}"
                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                Visibility="{x:Bind ViewModelDeleteBrowserContent.IsBusy, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
        </Grid>

        <Grid
            Grid.Row="0"
            Grid.RowSpan="4"
            Padding="20"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            CornerRadius="8"
            Visibility="{x:Bind ViewModelDeleteBrowserContent.IsProcessConflict, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">

            <StackPanel Spacing="15" VerticalAlignment="Center">
                <!--  Warnung/Konflikt-Symbol (StatusErrorFull)  -->
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="40"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Glyph="&#xE7BA;" />

                <TextBlock
                    x:Uid="ConflictDialog_Title"
                    HorizontalAlignment="Center"
                    FontSize="18"
                    FontWeight="Bold" />

                <TextBlock
                    x:Uid="DeleteDialog_ConflictMessage"
                    HorizontalAlignment="Center"
                    Opacity="0.8"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />

                <Grid Margin="0,15,0,0" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Uid="DeleteDialog_BtnForceClose"
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModelDeleteBrowserContent.ForceCloseAndContinueCommand}" />

                    <Button
                        x:Uid="DeleteDialog_BtnAbort"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModelDeleteBrowserContent.CancelConflictCommand}" />
                </Grid>
            </StackPanel>
        </Grid>

    </Grid>
</ContentDialog>